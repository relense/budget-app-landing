---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { getLangFromUrl, getAlternatePath, useTranslations, htmlLang, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Set for a standalone page with no true bilingual counterpart at the mirrored `/pt-pt/...`
   * path (e.g. the `/ferramentas/*` calculator pages, which are Portuguese-only by design, or an
   * English-only tool page whose PT equivalent lives at an unrelated URL). Suppresses the
   * hreflang alternate links (there's nothing valid to point them at) and the
   * PT-browser redirect script (there's no `/pt-pt/...` version to redirect a visitor to). */
  noAlternate?: boolean;
}

const { lang: langProp, noAlternate = false } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description') } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const alternateURL = new URL(getAlternatePath(Astro.url.pathname, lang), Astro.site);
const alternateLang = lang === 'en' ? 'pt-PT' : 'en';
// x-default always points at the English version, regardless of which locale is rendering.
const defaultLocaleURL = lang === 'en' ? canonicalURL : alternateURL;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Otterbond',
  url: Astro.site,
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1e1e1e" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {
      !noAlternate && (
        <>
          <link rel="alternate" hreflang={htmlLang[lang]} href={canonicalURL} />
          <link rel="alternate" hreflang={alternateLang} href={alternateURL} />
          <link rel="alternate" hreflang="x-default" href={defaultLocaleURL} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />

    <noscript>
      <style>
        [data-reveal],
        .price-card .feat {
          opacity: 1;
          transform: none;
        }
        .price-card .tick {
          transform: none;
        }
      </style>
    </noscript>

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Otterbond" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {
      !noAlternate && lang === 'en' && (
        <script is:inline define:vars={{ alternatePath: getAlternatePath(Astro.url.pathname, lang) }}>
          // System-based language redirect: if the browser's preferred (first) language is Portuguese
          // and the visitor lands on an English (default-locale) page, send them to the pt-PT equivalent.
          // Runs in <head> so it fires before first paint. Applies on every English landing (no
          // once-only flag, no manual override -- the language follows the system setting).
          // One-directional: /pt-pt/ pages are never redirected away, so shared links work as sent.
          try {
            const preferred = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            if (String(preferred).toLowerCase().startsWith('pt')) {
              window.location.replace(alternatePath + window.location.search + window.location.hash);
            }
          } catch {
            // navigator unavailable -- stay on English.
          }
        </script>
      )
    }
  </head>
  <body>
    <slot />

    <CookieConsent lang={lang} />

    <script>
      import { initLiveNumbers } from '../lib/liveNumbers';
      import { initSpotlight } from '../lib/spotlight';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      }

      // Decorative extras go last so a throw here can never leave the page unrevealed.
      for (const init of [initSpotlight, initLiveNumbers]) {
        try {
          init();
        } catch (err) {
          console.error(err);
        }
      }
    </script>
  </body>
</html>
