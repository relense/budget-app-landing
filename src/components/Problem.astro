---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="border-y border-[var(--color-line)] bg-[var(--color-bg-elevated)] py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
    <p class="text-2xl leading-snug font-medium text-[var(--color-ink)] sm:text-3xl">
      {t('problem.text')}
    </p>
  </div>
</section>
