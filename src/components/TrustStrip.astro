---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="border-y border-[var(--color-line)] bg-[var(--color-bg-elevated)]">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-5 py-6 text-center sm:flex-row sm:justify-center sm:gap-3 sm:px-8"
  >
    <Icon name="shield-check" class="h-5 w-5 flex-shrink-0 text-[var(--color-mint)]" />
    <p class="text-[15px] font-medium text-[var(--color-mint)]">
      {t('trustStrip.text')}
    </p>
  </div>
</section>
