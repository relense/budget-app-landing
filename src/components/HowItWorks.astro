---
// Four steps, each with a tiny looping demo of what that step looks like in the app. Copy comes from
// `howItWorks.*` in ui.ts; the demos are language-neutral (numbers and shapes only) apart from the
// number formatting and the "/day" suffix.
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === 'en';
const locale = en ? 'en-IE' : 'pt-PT';
const eur = (n: number) =>
  new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
const steps = t('howItWorks.steps');
const tones = [
  { bg: 'var(--color-mint)', deep: 'var(--color-mint-deep)' },
  { bg: 'var(--color-cat-blue-bg)', deep: 'var(--color-cat-blue-icon)' },
  { bg: 'var(--color-cat-peach-bg)', deep: 'var(--color-cat-peach-icon)' },
  { bg: 'var(--color-cat-purple-bg)', deep: 'var(--color-cat-purple-icon)' },
];
// Days of the month grid that receive something (index, colour).
const marks: Array<[number, string]> = [
  [3, '#B97A4C'],
  [10, '#3E6FA6'],
  [17, '#7A5AA8'],
  [24, '#234D2E'],
];
const digits = ['1', '2', '.', '5', '0'];
---

<section id="how-it-works" class="bg-[var(--color-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2
      class="max-w-[20ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl"
      data-reveal
    >
      {t('howItWorks.heading')}
    </h2>

    <div class="steps mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <article
            class="step relative"
            data-reveal
            style={`--bg:${tones[i].bg};--deep:${tones[i].deep};transition-delay:${i * 90}ms`}
          >
            <div class="viz" aria-hidden="true">
              {i === 0 && (
                <div class="cal">
                  {Array.from({ length: 28 }, (_, c) => {
                    const mark = marks.findIndex(([idx]) => idx === c);
                    return mark >= 0 ? (
                      <span class="cell on" style={`--c:${marks[mark][1]};--k:${mark}`} />
                    ) : (
                      <span class="cell" />
                    );
                  })}
                </div>
              )}
              {i === 1 && (
                <div class="log">
                  <p class="amt">
                    <span class="cur">€</span>
                    {digits.map((d, k) => (
                      <span class={`dg d${k}`}>{d}</span>
                    ))}
                  </p>
                  <div class="row">
                    <span class="rc"><Icon name="coins" /></span>
                    <span class="lines"><i /><i /></span>
                    <b>{eur(12.5)}</b>
                  </div>
                </div>
              )}
              {i === 2 && (
                <div class="morning">
                  <span class="sun" />
                  <span class="ground" />
                  <p class="big">
                    <span data-count-to="104.77" data-decimals="2" data-locale={locale} data-currency="EUR">{eur(104.77)}</span>
                    <small>{en ? '/day' : '/dia'}</small>
                  </p>
                </div>
              )}
              {i === 3 && (
                <div class="lock">
                  <div class="segs">
                    {[0, 1, 2, 3, 4, 5].map((k) => (
                      <i style={`--k:${k}`} />
                    ))}
                  </div>
                  <div class="padlock">
                    <span class="shackle" />
                    <span class="body"><Icon name="check" /></span>
                  </div>
                </div>
              )}
            </div>

            <div class="txt">
              <span class="ico"><Icon name={(['calendar-blank', 'coins', 'check-circle', 'lock-simple'] as const)[i]} /></span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>

            {i < 3 && (
              <span class="arrow" style={`--i:${i}`} aria-hidden="true"><Icon name="arrow-right" /></span>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { countUp } from '../lib/countUp';

  // Counts the morning number up whenever that card scrolls into view.
  const card = document.querySelector<HTMLElement>('#how-it-works .morning');
  if (card && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) countUp(card);
      },
      { threshold: 0.6 },
    ).observe(card);
  }
</script>

<style>
  .step {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--bg);
    color: #1a1a1a;
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .step:hover {
    transform: translateY(-6px);
  }
  .viz {
    position: relative;
    height: 190px;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.32);
  }
  .txt {
    position: relative;
    padding: 22px 22px 26px;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: #fff;
    color: var(--deep);
  }
  .ico :global(svg) {
    width: 20px;
    height: 20px;
  }
  h3 {
    font-size: 19px;
    line-height: 1.2;
    font-weight: 500;
    color: #1a1a1a;
  }
  .txt p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.5;
    color: rgb(26 26 26 / 0.78);
    max-width: 30ch;
  }

  /* 1: the month fills up */
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 26px);
    gap: 6px;
  }
  .cell {
    width: 26px;
    height: 22px;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.7);
  }
  .cell.on {
    background: var(--c);
  }

  /* 2: type an amount, the expense row lands */
  .log {
    width: 78%;
  }
  .amt {
    text-align: center;
    font-size: 38px;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: #1a1a1a;
  }
  .cur {
    margin-right: 2px;
    font-size: 22px;
    color: rgb(26 26 26 / 0.55);
  }
  .dg {
    display: inline-block;
    overflow: hidden;
    max-width: 24px;
    vertical-align: bottom;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 14px;
    background: #fff;
  }
  .rc {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #f3d9c8;
    color: #1a1a1a;
  }
  .rc :global(svg) {
    width: 16px;
    height: 16px;
  }
  .lines {
    flex: 1;
    display: grid;
    gap: 5px;
  }
  .lines i {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: rgb(26 26 26 / 0.16);
  }
  .lines i:last-child {
    width: 60%;
  }
  .row b {
    font-size: 14px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  /* 3: the sun comes up and the number is there */
  .morning {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .sun {
    position: absolute;
    left: 50%;
    bottom: 56px;
    width: 92px;
    height: 92px;
    margin-left: -46px;
    border-radius: 50%;
    background: #f5e27a;
    box-shadow: 0 0 0 14px rgb(245 226 122 / 0.32);
  }
  .ground {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
    background: rgb(26 26 26 / 0.12);
  }
  .big {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    text-align: center;
    font-size: 30px;
    color: #1a1a1a;
    font-variant-numeric: tabular-nums;
  }
  .big small {
    margin-left: 3px;
    font-size: 14px;
    color: rgb(26 26 26 / 0.6);
  }

  /* 4: lock the month, the wrap fills */
  .lock {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .segs {
    display: flex;
    gap: 5px;
  }
  .segs i {
    display: block;
    width: 26px;
    height: 5px;
    border-radius: 3px;
    background: #1a1a1a;
  }
  .padlock {
    position: relative;
    width: 64px;
    height: 78px;
  }
  .shackle {
    position: absolute;
    left: 12px;
    top: 0;
    width: 40px;
    height: 42px;
    border: 8px solid #3a3a3a;
    border-bottom: 0;
    border-radius: 22px 22px 0 0;
    transform-origin: 8px 42px;
  }
  .body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #3a3a3a;
    color: #f5e27a;
  }
  .body :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* arrows between the cards light up in turn */
  .arrow {
    display: none;
  }
  @media (min-width: 1024px) {
    .arrow {
      position: absolute;
      z-index: 2;
      right: -20px;
      top: 73px;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #fff;
      color: #1a1a1a;
      box-shadow: 0 6px 16px -4px rgb(0 0 0 / 0.4);
    }
    .arrow :global(svg) {
      width: 15px;
      height: 15px;
    }
    /* the last card's overflow must not clip the arrow that sits in the gap */
    .step {
      overflow: visible;
    }
    .viz {
      border-radius: var(--radius-card) var(--radius-card) 0 0;
    }
    .txt {
      border-radius: 0 0 var(--radius-card) var(--radius-card);
    }
  }

  /* Loops run while the card is on screen (data-reveal adds .is-visible) */
  @media (prefers-reduced-motion: no-preference) {
    .step.is-visible .cell.on {
      animation: cell-pop 6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
      animation-delay: calc(var(--k) * 0.45s);
    }
    .step.is-visible .dg {
      animation: dg-type 6s ease infinite;
    }
    .step.is-visible .d0 { animation-delay: 0.3s; }
    .step.is-visible .d1 { animation-delay: 0.7s; }
    .step.is-visible .d2 { animation-delay: 1.1s; }
    .step.is-visible .d3 { animation-delay: 1.5s; }
    .step.is-visible .d4 { animation-delay: 1.9s; }
    .step.is-visible .row {
      animation: row-in 6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }
    .step.is-visible .sun {
      animation: sun-up 6s ease-in-out infinite;
    }
    .step.is-visible .big {
      animation: big-in 6s ease infinite;
    }
    .step.is-visible .segs i {
      animation: seg-fill 6s ease infinite;
      animation-delay: calc(var(--k) * 0.35s);
    }
    .step.is-visible .shackle {
      animation: shackle 6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    .step.is-visible .padlock {
      animation: padlock 6s ease infinite;
    }
    .step.is-visible .arrow {
      animation: arrow-glow 6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 1.5s);
    }
  }
  @keyframes cell-pop {
    0% { transform: scale(0.4); opacity: 0.2; }
    8%, 88% { transform: scale(1); opacity: 1; }
    96%, 100% { transform: scale(0.4); opacity: 0.2; }
  }
  @keyframes dg-type {
    0%, 2% { max-width: 0; opacity: 0; }
    6%, 84% { max-width: 24px; opacity: 1; }
    92%, 100% { max-width: 0; opacity: 0; }
  }
  @keyframes row-in {
    0%, 40% { opacity: 0; transform: translateY(14px); }
    50%, 84% { opacity: 1; transform: none; }
    94%, 100% { opacity: 0; transform: translateY(14px); }
  }
  @keyframes sun-up {
    0%, 100% { transform: translateY(70px); }
    35%, 70% { transform: translateY(0); }
  }
  @keyframes big-in {
    0%, 20% { opacity: 0; transform: translateY(10px); }
    38%, 84% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0; }
  }
  @keyframes seg-fill {
    0% { opacity: 0.18; transform: scaleX(0.4); }
    6%, 84% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0.18; transform: scaleX(0.4); }
  }
  @keyframes shackle {
    0%, 40% { transform: translateY(-12px) rotate(-14deg); }
    52%, 100% { transform: none; }
  }
  @keyframes padlock {
    0%, 50% { transform: none; }
    56% { transform: scale(1.1); }
    64%, 100% { transform: none; }
  }
  @keyframes arrow-glow {
    0%, 30%, 100% { transform: scale(1); background: #fff; }
    10% { transform: scale(1.3); background: #cff3da; }
  }
</style>
