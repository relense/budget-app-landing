---
import { Image } from 'astro:assets';
import desktopHome from '../assets/screenshots/desktop-home.png';
import mobileHome from '../assets/screenshots/mobile-home.png';
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-[var(--color-bg)] pt-14 pb-20 sm:pt-20 sm:pb-28">
  <div
    class="pointer-events-none absolute -top-24 right-[-10%] h-[520px] w-[520px] rounded-full bg-[var(--color-mint)]/10 blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1fr_1.05fr] lg:gap-8"
  >
    <div data-reveal>
      <h1
        class="max-w-[16ch] text-4xl leading-[1.1] font-medium tracking-tight text-[var(--color-ink)] sm:text-5xl lg:text-6xl"
      >
        {t('hero.title')}
      </h1>
      <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-[var(--color-ink-soft)]">
        {t('hero.subtitle')}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#waitlist"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white shadow-[var(--shadow-lifted)] transition-transform active:scale-[0.98]"
        >
          {t('hero.cta')}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-10 flex items-center gap-2 text-[13px] font-medium text-[var(--color-ink-faint)] lg:hidden">
        <span>{t('hero.scrollHint')}</span>
        <Icon name="caret-down" class="h-4 w-4 animate-bounce" />
      </div>
    </div>

    <div class="relative" data-reveal style="transition-delay: 120ms">
      <div
        class="relative mx-auto max-w-[560px] rotate-[-2deg] overflow-hidden rounded-2xl border border-[var(--color-line)] shadow-[var(--shadow-lifted)] sm:rounded-[28px]"
      >
        <Image
          src={desktopHome}
          alt={t('hero.desktopAlt')}
          width={800}
          loading="eager"
          fetchpriority="high"
          class="w-full"
        />
      </div>

      <div
        class="absolute -bottom-10 -left-4 w-[150px] rotate-[4deg] overflow-hidden rounded-[22px] border-4 border-[var(--color-bg-elevated)] shadow-[var(--shadow-lifted)] sm:-bottom-12 sm:-left-8 sm:w-[190px]"
      >
        <Image
          src={mobileHome}
          alt={t('hero.mobileAlt')}
          width={420}
          loading="eager"
          class="w-full"
        />
      </div>
    </div>
  </div>
</section>
