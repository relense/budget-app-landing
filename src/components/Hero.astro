---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const words = t('hero.title').split(' ');
---

<div class="hero-copy">
      <h1
        class="max-w-[22ch] text-4xl leading-[1.1] font-medium tracking-tight text-[var(--color-ink)] sm:text-5xl lg:text-[3.4rem]"
        aria-label={t('hero.title')}
      >
        {words.map((word, i) => (
          <span class="hw" style={`--i:${i}`} aria-hidden="true">{word} </span>
        ))}
      </h1>
      <p class="hero-rise mt-6 max-w-[46ch] text-lg leading-relaxed text-[var(--color-ink-soft)]" style="--d:.55s">
        {t('hero.subtitle')}
      </p>

      <div class="hero-rise mt-9 flex flex-wrap items-center gap-3" style="--d:.7s">
        <span class="cta-wrap">
          <a
            href="https://app.otterbond.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-shine inline-flex items-center gap-2 rounded-full bg-[var(--color-mint)] px-7 py-3.5 text-[15px] font-medium text-[var(--color-mint-deep)] transition-transform active:scale-[0.98]"
          >
            {t('hero.cta')}
            <Icon name="arrow-right" class="cta-arrow h-4 w-4" />
          </a>
        </span>
        <a
          href="#waitlist"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-line)] px-6 py-3.5 text-[15px] font-medium text-[var(--color-ink)] transition-colors hover:border-[var(--color-ink-faint)] active:scale-[0.98]"
        >
          {t('hero.waitlistCta')}
        </a>
      </div>

      <p class="hero-rise mt-6 max-w-[46ch] text-[14px] leading-relaxed text-[var(--color-ink-faint)]" style="--d:.85s">
        {t('hero.trustLine')}
      </p>
    </div>

<style>
  .hw {
    display: inline-block;
    white-space: pre;
  }
  /* The invitation on the button itself: a ring that pings, a hop, and the arrow nudging. */
  .cta-wrap {
    position: relative;
    display: inline-flex;
  }
  .cta-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid var(--color-mint);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hw {
      animation: hw-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 70ms + 0.05s);
    }
    .hero-rise {
      animation: hw-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0s);
    }
    .cta-wrap {
      animation: cta-hop 6s ease-in-out 3s infinite;
    }
    .cta-wrap::before {
      animation: cta-ring 3s ease-out 1.5s infinite;
    }
    .cta-wrap :global(.cta-arrow) {
      animation: cta-nudge 1.6s ease-in-out infinite;
    }
    .cta-shine {
      position: relative;
      overflow: hidden;
    }
    .cta-shine::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.55) 50%, transparent 65%);
      transform: translateX(-120%);
      animation: shine 5s ease-in-out 2.5s infinite;
    }
  }
  @keyframes cta-hop {
    0%,
    14%,
    100% {
      transform: translateY(0);
    }
    4% {
      transform: translateY(-9px);
    }
    8% {
      transform: translateY(0);
    }
    11% {
      transform: translateY(-4px);
    }
  }
  @keyframes cta-ring {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.35, 1.7);
    }
  }
  @keyframes cta-nudge {
    50% {
      transform: translateX(4px);
    }
  }
  @keyframes hw-in {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }
  @keyframes shine {
    0%,
    55% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }
</style>
