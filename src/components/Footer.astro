---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { CREATOR_GITHUB_URL } from '../lib/constants';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : '/pt-pt';
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-bg)] py-14">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-[32ch]">
        <a href={prefix || '/'} class="flex items-center gap-2.5">
          <Image src={logo} alt="Otterbond" width={28} height={28} class="h-7 w-7" />
          <span class="text-base font-medium text-[var(--color-ink)]">Otterbond</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
          {t('footer.tagline')}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-medium text-[var(--color-ink)]">{t('footer.legalHeading')}</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-soft)]">
          <li><a href={`${prefix}/privacy`} class="hover:text-[var(--color-ink)]">{t('footer.privacy')}</a></li>
          <li><a href={`${prefix}/terms`} class="hover:text-[var(--color-ink)]">{t('footer.terms')}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-ink-faint)]">&copy; {year} Otterbond.</p>
      <a
        href={CREATOR_GITHUB_URL}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 text-xs text-[var(--color-ink-faint)] hover:text-[var(--color-ink)]"
      >
        <Icon name="github-logo" class="h-3.5 w-3.5" />
        {t('footer.madeBy')}
      </a>
    </div>
  </div>
</footer>
