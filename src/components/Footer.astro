---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] bg-white py-14">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-[32ch]">
        <a href="/" class="flex items-center gap-2.5">
          <Image src={logo} alt="Project Arwen" width={28} height={28} class="h-7 w-7" />
          <span class="text-base font-medium text-[var(--color-ink)]">Project Arwen</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
          A shared, multi-currency budget and savings tracker.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-medium text-[var(--color-ink)]">Legal</h3>
        <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-soft)]">
          <li><a href="/privacy" class="hover:text-[var(--color-ink)]">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[var(--color-ink)]">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <p class="mt-12 text-xs text-[var(--color-ink-faint)]">&copy; {year} Project Arwen.</p>
  </div>
</footer>
