---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { GITHUB_REPOS } from '../lib/constants';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)] bg-white py-14">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-[32ch]">
        <a href="/" class="flex items-center gap-2.5">
          <Image src={logo} alt="Budget Tracker" width={28} height={28} class="h-7 w-7" />
          <span class="text-base font-medium text-[var(--color-ink)]">Budget Tracker</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
          A shared, multi-currency budget and savings tracker. Built solo, end to end.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:flex sm:gap-16">
        <div>
          <h3 class="text-sm font-medium text-[var(--color-ink)]">Legal</h3>
          <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-soft)]">
            <li><a href="/privacy" class="hover:text-[var(--color-ink)]">Privacy Policy</a></li>
            <li><a href="/terms" class="hover:text-[var(--color-ink)]">Terms of Service</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-medium text-[var(--color-ink)]">Source</h3>
          <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-soft)]">
            {
              GITHUB_REPOS.map((repo) => (
                <li>
                  <a
                    href={repo.url}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-1.5 hover:text-[var(--color-ink)]"
                  >
                    <Icon name="github-logo" class="h-3.5 w-3.5" />
                    {repo.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-12 text-xs text-[var(--color-ink-faint)]">
      &copy; {year} Miguel Furtado. Portfolio project, not a company.
    </p>
  </div>
</footer>
