---
import { Image } from 'astro:assets';

import mobileHome from '../assets/screenshots/mobile-home.png';
import mobileBudget from '../assets/screenshots/mobile-budget.png';
import mobileCalculator from '../assets/screenshots/mobile-calculator.png';
import mobileExpenses from '../assets/screenshots/mobile-Expenses.png';
import mobileRecurrent from '../assets/screenshots/mobile-recurrent-expenses.png';
import mobileIncome from '../assets/screenshots/mobile-Income.png';
import mobileSavings from '../assets/screenshots/mobile--savings.png';
import webHome from '../assets/screenshots/web-home.png';
import webExpenses from '../assets/screenshots/web-expenses.png';
import webSavings from '../assets/screenshots/web-savings.png';
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const mobileImages = [
  mobileHome,
  mobileBudget,
  mobileCalculator,
  mobileExpenses,
  mobileRecurrent,
  mobileIncome,
  mobileSavings,
];
const webImages = [webHome, webExpenses, webSavings];

const expandHint = t('screenshotGallery.expandHint');

const platforms = [
  {
    key: 'mobile',
    label: t('screenshotGallery.tabMobile'),
    altPrefix: t('screenshotGallery.altPrefixMobile'),
    cardClass: 'w-[52vw] sm:w-[240px]',
    shots: t('screenshotGallery.shots').map((caption, i) => ({ src: mobileImages[i], caption })),
  },
  {
    key: 'web',
    label: t('screenshotGallery.tabWeb'),
    altPrefix: t('screenshotGallery.altPrefixWeb'),
    cardClass: 'w-[85vw] sm:w-[420px]',
    shots: t('screenshotGallery.webShots').map((caption, i) => ({ src: webImages[i], caption })),
  },
];
---

<section id="screens" class="bg-[var(--color-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2
      class="max-w-[20ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl"
      data-reveal
    >
      {t('screenshotGallery.heading')}
    </h2>

    <div data-reveal style="transition-delay: 80ms">
      <div
        class="mt-8 inline-flex rounded-[var(--radius-pill)] bg-[var(--color-bg-elevated)] p-1"
        role="tablist"
      >
        {
          platforms.map((platform, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-platform-tab={platform.key}
              class:list={[
                'rounded-[var(--radius-pill)] px-5 py-2 text-sm font-medium transition-colors',
                i === 0
                  ? 'bg-[var(--color-pill)] text-[var(--color-ink)]'
                  : 'text-[var(--color-ink-faint)]',
              ]}
            >
              {platform.label}
            </button>
          ))
        }
      </div>

      {
        platforms.map((platform, i) => (
          <div
            class="mt-10 -mx-5 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0"
            data-platform-panel={platform.key}
            hidden={i !== 0}
          >
            {platform.shots.map((shot, j) => (
              <button
                type="button"
                class={`${platform.cardClass} flex-shrink-0 snap-start text-left`}
                data-lightbox-platform={platform.key}
                data-lightbox-index={j}
                aria-label={`${platform.altPrefix}: ${shot.caption}. ${expandHint}`}
              >
                <div class="cursor-zoom-in overflow-hidden rounded-[24px] border-4 border-[var(--color-bg-elevated)] shadow-[var(--shadow-soft)] transition-transform active:scale-[0.98]">
                  <Image src={shot.src} alt="" width={420} class="w-full" />
                </div>
                <p class="mt-3 text-sm text-[var(--color-ink-soft)]">{shot.caption}</p>
              </button>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/97 p-2"
  role="dialog"
  aria-modal="true"
  aria-label={t('screenshotGallery.viewerLabel')}
>
  <button
    type="button"
    id="lightbox-close"
    aria-label={t('screenshotGallery.close')}
    class="absolute top-4 right-4 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
  >
    <Icon name="x" class="h-5 w-5" />
  </button>

  <button
    type="button"
    id="lightbox-prev"
    aria-label={t('screenshotGallery.previous')}
    class="absolute left-2 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:left-6"
  >
    <Icon name="caret-left" class="h-5 w-5" />
  </button>

  <button
    type="button"
    id="lightbox-next"
    aria-label={t('screenshotGallery.next')}
    class="absolute right-2 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 sm:right-6"
  >
    <Icon name="caret-right" class="h-5 w-5" />
  </button>

  <div class="flex max-h-full max-w-full flex-col items-center">
    <div id="lightbox-stage" class="relative flex max-h-[88vh] items-center justify-center">
      {
        platforms.map((platform) =>
          platform.shots.map((shot, j) => (
            <div
              class="lightbox-slide hidden"
              data-platform={platform.key}
              data-index={j}
              data-caption={shot.caption}
            >
              <Image
                src={shot.src}
                alt={`${platform.altPrefix}: ${shot.caption}`}
                width={1200}
                class="max-h-[88vh] w-auto max-w-[95vw] rounded-[28px] border-4 border-[var(--color-bg-elevated)] shadow-[var(--shadow-lifted)]"
              />
            </div>
          ))
        )
      }
    </div>
    <p id="lightbox-caption" class="mt-4 text-center text-[15px] text-white">
      &nbsp;
    </p>
    <p id="lightbox-counter" class="mt-1 text-center text-xs text-white/60">&nbsp;</p>
  </div>
</div>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-platform-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-platform-panel]');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const platform = button.dataset.platformTab;
      tabButtons.forEach((b) => {
        const active = b === button;
        b.classList.toggle('bg-[var(--color-pill)]', active);
        b.classList.toggle('text-[var(--color-ink)]', active);
        b.classList.toggle('text-[var(--color-ink-faint)]', !active);
        b.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.platformPanel !== platform;
      });
    });
  });

  const openers = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-index]');
  const lightbox = document.getElementById('lightbox');
  const stage = document.getElementById('lightbox-stage');
  const captionEl = document.getElementById('lightbox-caption');
  const counterEl = document.getElementById('lightbox-counter');
  const closeButton = document.getElementById('lightbox-close');
  const prevButton = document.getElementById('lightbox-prev');
  const nextButton = document.getElementById('lightbox-next');

  let currentPlatform = 'mobile';
  let current = 0;

  function slidesFor(platform: string) {
    return Array.from(
      document.querySelectorAll<HTMLElement>(`.lightbox-slide[data-platform="${platform}"]`)
    );
  }

  function show(index: number) {
    const slides = slidesFor(currentPlatform);
    const total = slides.length;
    current = ((index % total) + total) % total;
    document.querySelectorAll<HTMLElement>('.lightbox-slide').forEach((slide) => {
      const isActive = slide.dataset.platform === currentPlatform && Number(slide.dataset.index) === current;
      slide.classList.toggle('hidden', !isActive);
    });
    if (captionEl) captionEl.textContent = slides[current]?.dataset.caption ?? '';
    if (counterEl) counterEl.textContent = `${current + 1} / ${total}`;
  }

  function open(platform: string, index: number) {
    currentPlatform = platform;
    show(index);
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.classList.add('overflow-hidden');
  }

  function close() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.classList.remove('overflow-hidden');
  }

  function isOpen() {
    return !lightbox?.classList.contains('hidden');
  }

  openers.forEach((opener) => {
    opener.addEventListener('click', () => {
      const platform = opener.dataset.lightboxPlatform ?? 'mobile';
      const index = Number(opener.dataset.lightboxIndex);
      open(platform, index);
    });
  });

  closeButton?.addEventListener('click', close);
  prevButton?.addEventListener('click', () => show(current - 1));
  nextButton?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) close();
  });

  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  let touchStartX = 0;
  stage?.addEventListener(
    'touchstart',
    (event) => {
      touchStartX = event.touches[0].clientX;
    },
    { passive: true }
  );
  stage?.addEventListener(
    'touchend',
    (event) => {
      const deltaX = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(deltaX) < 40) return;
      show(deltaX > 0 ? current - 1 : current + 1);
    },
    { passive: true }
  );
</script>
</content>
