---
import { Image } from 'astro:assets';

import mobileHome from '../assets/screenshots/mobile-home.png';
import mobileBudget from '../assets/screenshots/mobile-budget.png';
import mobileSavings from '../assets/screenshots/mobile-savings.png';
import mobileCurrency from '../assets/screenshots/mobile-currency.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const images = [mobileHome, mobileBudget, mobileSavings, mobileCurrency];
const mobileShots = t('screenshotGallery.shots').map((caption, i) => ({ src: images[i], caption }));
const altPrefix = t('screenshotGallery.altPrefix');
---

<section id="screens" class="bg-[var(--color-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2
      class="max-w-[20ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl"
      data-reveal
    >
      {t('screenshotGallery.heading')}
    </h2>

    <div
      class="mt-10 -mx-5 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0"
      data-reveal
      style="transition-delay: 80ms"
    >
      {
        mobileShots.map((shot) => (
          <figure class="w-[52vw] flex-shrink-0 snap-start sm:w-[240px]">
            <div class="overflow-hidden rounded-[24px] border-4 border-[var(--color-bg-elevated)] shadow-[var(--shadow-soft)]">
              <Image
                src={shot.src}
                alt={`${altPrefix}: ${shot.caption}`}
                width={420}
                class="w-full"
              />
            </div>
            <figcaption class="mt-3 text-sm text-[var(--color-ink-soft)]">
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
