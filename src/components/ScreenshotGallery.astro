---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

import desktopHome from '../assets/screenshots/desktop-home.png';
import desktopCategoryDetail from '../assets/screenshots/desktop-category-detail.png';
import desktopCategorize from '../assets/screenshots/desktop-categorize.png';
import desktopSavings from '../assets/screenshots/desktop-savings.png';
import desktopAddExpense from '../assets/screenshots/desktop-add-expense.png';

import mobileHome from '../assets/screenshots/mobile-home.png';
import mobileBudget from '../assets/screenshots/mobile-budget.png';
import mobileSavings from '../assets/screenshots/mobile-savings.png';
import mobileCurrency from '../assets/screenshots/mobile-currency.png';

const desktopShots = [
  { src: desktopHome, caption: 'Home dashboard' },
  { src: desktopCategoryDetail, caption: 'Category detail' },
  { src: desktopCategorize, caption: 'Categorize expenses' },
  { src: desktopSavings, caption: 'Savings funds' },
  { src: desktopAddExpense, caption: 'Add an expense' },
];

const mobileShots = [
  { src: mobileHome, caption: 'Home, in dark mode' },
  { src: mobileBudget, caption: 'Budget by category' },
  { src: mobileSavings, caption: 'Savings funds' },
  { src: mobileCurrency, caption: 'Currency settings' },
];
---

<section id="screens" class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div
      class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end"
      data-reveal
    >
      <h2 class="max-w-[20ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
        See it, don't just take our word for it
      </h2>

      <div
        role="tablist"
        aria-label="Screenshot platform"
        class="flex rounded-full bg-[#f0f0ee] p-1"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-gallery-tab="desktop"
          class="gallery-tab flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="desktop" class="h-4 w-4" />
          Desktop
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-gallery-tab="mobile"
          class="gallery-tab flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="device-mobile" class="h-4 w-4" />
          Mobile
        </button>
      </div>
    </div>

    <div
      data-gallery-panel="desktop"
      class="mt-10 -mx-5 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0"
    >
      {
        desktopShots.map((shot) => (
          <figure class="w-[78vw] flex-shrink-0 snap-start sm:w-[420px]">
            <div class="overflow-hidden rounded-2xl border border-[var(--color-line)] shadow-[var(--shadow-soft)]">
              <Image src={shot.src} alt={`Budget Tracker web screenshot: ${shot.caption}`} width={640} class="w-full" />
            </div>
            <figcaption class="mt-3 text-sm text-[var(--color-ink-soft)]">{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <div
      data-gallery-panel="mobile"
      class="mt-10 -mx-5 hidden snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-4 sm:mx-0 sm:px-0"
    >
      {
        mobileShots.map((shot) => (
          <figure class="w-[52vw] flex-shrink-0 snap-start sm:w-[240px]">
            <div class="overflow-hidden rounded-[24px] border-4 border-[#16171a] shadow-[var(--shadow-soft)]">
              <Image src={shot.src} alt={`Budget Tracker mobile screenshot: ${shot.caption}`} width={420} class="w-full" />
            </div>
            <figcaption class="mt-3 text-sm text-[var(--color-ink-soft)]">{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-tab[aria-selected='true'] {
    background: #131313;
    color: #fff;
  }
  .gallery-tab[aria-selected='false'] {
    color: var(--color-ink-soft);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-gallery-tab]');
  const panels = document.querySelectorAll<HTMLDivElement>('[data-gallery-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.galleryTab;

      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.galleryPanel !== target);
        panel.classList.toggle('flex', panel.dataset.galleryPanel === target);
      });
    });
  });
</script>
