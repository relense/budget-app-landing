---
import Icon from './Icon.astro';

const platforms = [
  { icon: 'desktop' as const, label: 'Web app', status: 'In staging' },
  { icon: 'apple-logo' as const, label: 'iOS app', status: 'Coming soon' },
  { icon: 'google-play-logo' as const, label: 'Android app', status: 'Coming soon' },
];
---

<section class="bg-[var(--color-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2
      class="max-w-[24ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl"
      data-reveal
    >
      Web, iOS, and Android are all in progress
    </h2>
    <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]" data-reveal>
      Nothing is public yet: the web app is still in staging and the mobile apps haven't shipped.
      Join the waitlist below and we'll email you the moment any of them are ready.
    </p>

    <div class="mt-12 flex flex-wrap gap-x-12 gap-y-8" data-reveal style="transition-delay: 80ms">
      {
        platforms.map((platform) => (
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-bg-elevated)] text-[var(--color-ink-soft)]">
              <Icon name={platform.icon} class="h-5 w-5" />
            </div>
            <div>
              <p class="text-[15px] font-medium text-[var(--color-ink)]">{platform.label}</p>
              <p class="text-sm text-[var(--color-ink-faint)]">{platform.status}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
