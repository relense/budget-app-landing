---
import Icon from './Icon.astro';
import { WEB_APP_URL, IOS_STORE_URL, ANDROID_STORE_URL } from '../lib/constants';
---

<section class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 class="max-w-[24ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl" data-reveal>
      Use it on the web today, or wait for the app
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div
        class="rounded-[var(--radius-card)] bg-[var(--color-bg-mint)] p-8 sm:p-10"
        data-reveal
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-[var(--color-mint-deep)]">
          <Icon name="desktop" class="h-6 w-6" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-ink)]">Web app</h3>
        <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[#2b4a35]">
          Works right now, no install needed. Sign in with your email and you're straight in.
        </p>
        <a
          href={WEB_APP_URL}
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-6 py-3 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
        >
          Get started
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div
        class="rounded-[var(--radius-card)] border border-dashed border-[var(--color-line)] p-8 sm:p-10"
        data-reveal
        style="transition-delay: 80ms"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#f0f0ee] text-[var(--color-ink-soft)]">
          <Icon name="device-mobile" class="h-6 w-6" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-ink)]">iOS &amp; Android app</h3>
        <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
          Built and working, not yet published to the app stores. Link coming soon.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            IOS_STORE_URL ? (
              <a
                href={IOS_STORE_URL}
                class="inline-flex items-center gap-2 rounded-full border border-[var(--color-ink)] px-6 py-3 text-[15px] font-medium text-[var(--color-ink)]"
              >
                <Icon name="apple-logo" class="h-4 w-4" />
                App Store
              </a>
            ) : (
              <span
                aria-disabled="true"
                class="inline-flex cursor-not-allowed items-center gap-2 rounded-full border border-[var(--color-line)] px-6 py-3 text-[15px] font-medium text-[var(--color-ink-faint)]"
              >
                <Icon name="apple-logo" class="h-4 w-4" />
                App Store
              </span>
            )
          }
          {
            ANDROID_STORE_URL ? (
              <a
                href={ANDROID_STORE_URL}
                class="inline-flex items-center gap-2 rounded-full border border-[var(--color-ink)] px-6 py-3 text-[15px] font-medium text-[var(--color-ink)]"
              >
                <Icon name="google-play-logo" class="h-4 w-4" />
                Google Play
              </a>
            ) : (
              <span
                aria-disabled="true"
                class="inline-flex cursor-not-allowed items-center gap-2 rounded-full border border-[var(--color-line)] px-6 py-3 text-[15px] font-medium text-[var(--color-ink-faint)]"
              >
                <Icon name="google-play-logo" class="h-4 w-4" />
                Google Play
              </span>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
