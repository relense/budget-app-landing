---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const stats = t('portfolioNote.stats');
---

<section class="border-y border-[var(--color-line)] bg-[var(--color-bg-elevated)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-[52ch]" data-reveal>
      <h2 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
        {t('portfolioNote.heading')}
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        {t('portfolioNote.body')}
      </p>
    </div>

    <dl
      class="mt-12 grid grid-cols-2 gap-x-8 gap-y-10 divide-[var(--color-line)] sm:grid-cols-4 sm:divide-x"
      data-reveal
      style="transition-delay: 100ms"
    >
      {
        stats.map((stat) => (
          <div class="sm:px-6 sm:first:pl-0">
            <dt class="font-mono text-3xl font-medium text-[var(--color-ink)] sm:text-4xl">
              {stat.value}
            </dt>
            <dd class="mt-2 text-sm text-[var(--color-ink-soft)]">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
