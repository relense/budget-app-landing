---
// Code-drawn replicas of real Otterbond mobile screens (dark theme). Every layout, colour, icon,
// size and string here comes from the app's own code (budget-app-mobile: src/theme/colors.ts,
// typography.ts, the screen and component files, and the en / pt-PT i18n resources); sizes are the
// app's 390pt design, scaled with one unit (`--u` = 1pt). Fredoka Regular only, exactly as the app.
//
// What is NOT real: the numbers (sample data; a few come from the app's own screenshots), and the
// motion. The app itself barely animates, so every animation here replays something a person does
// (typing on the keypad, tapping a bill group, dragging the what-if slider, tapping through the
// wrap) or a data change that follows from it. Nothing here adds UI the app doesn't have.
//
// Animation contract: with no `.is-live` ancestor a screen shows its final frame (that is also the
// JS-off and reduced-motion state). `.is-live`, set by the parent, starts the replay.
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  kind:
    | 'home'
    | 'couple'
    | 'spreadsheet'
    | 'payday'
    | 'saver'
    | 'freelancer'
    | 'privacy'
    | 'expat'
    | 'closer';
}

const { kind } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const en = lang === 'en';
const locale = en ? 'en-IE' : 'pt-PT';
const fmt = (n: number, d = 2) =>
  new Intl.NumberFormat(locale, {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: d,
    maximumFractionDigits: d,
  }).format(n);
const signed = (n: number) => (n > 0 ? '+' : '') + fmt(n);
const fill = (s: string, v: Record<string, string | number>) =>
  s.replace(/\{\{(\w+)\}\}/g, (_, k) => String(v[k] ?? ''));

