                      <p class="wcap red">{fill(T.vsLast, { delta: `-${fmt(54.09)}` })}</p>
                    </>
                  )}
                  {i === 1 && (
                    <>
                      <p class="eb">{T.incomeSpent}</p>
                      <div class="wgrid">
                        <span><b>{fmt(5244.79)}</b><small>{T.incomeLbl}</small><em>{fill(T.vsLast, { delta: signed(2.48) })}</em></span>
                        <span><b>{fmt(2862.99)}</b><small>{T.spentLbl}</small><em>{fill(T.vsLast, { delta: signed(69.92) })}</em></span>
                      </div>
                    </>
                  )}
                  {i === 2 && (
                    <>
                      <p class="eb">{T.whereWent}</p>
                      <div class="wtop">
                        <em>{T.topCat}</em>
                        <p class="wh22">{T.fixedBills}</p>
                        <p class="wcap">{fmt(1490.47)} · {fill(T.ofSpending, { percent: '52%' })}</p>
