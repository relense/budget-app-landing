---

<div class:list={['ls', `ls-${kind}`]} aria-hidden="true" inert>
  <div class="ls-body">
    {
      kind !== 'closer' && kind !== 'privacy' && (
        <div class="sb">
          <span>9:41</span>
          <span class="sbr">
            <i class="mdi mdi-signal-cellular-3" />
            <i class="mdi mdi-wifi" />
            <i class="mdi mdi-battery" />
          </span>
        </div>
      )
    }

    {/* ---------------------------------------------------------------- HOME */}
    {
      kind === 'home' && (
        <>
          <div class="hd">
            <span class="greet">{T.greeting}</span>
          </div>
          <div class="sw">
            <span>{T.personal}</span>
            <i class="mdi mdi-account-switch" />
          </div>
          <div class="bell">
            <i class="mdi mdi-bell-outline" />
            <span class="bd">1</span>
          </div>

          <div class="balwrap">
            <div class="balrow ls-in" style="--d:.05s">
              <span class="ib"><i class="mdi mdi-eye-outline" /></span>
              <span class="amt" data-count-to="21984.42" data-decimals="2" data-locale={locale} data-currency="EUR">{fmt(21984.42)}</span>
              <span class="ib"><i class="mdi mdi-pencil-outline" /></span>
            </div>
            <p class="lbl">{T.total}</p>
            <div class="sts ls-in" style="--d:.2s">
              <p class="hl">
                <span set:html={fill(T.perDay, { amount: `<span data-count-to="104.77" data-decimals="2" data-locale="${locale}" data-currency="EUR">${fmt(104.77)}</span>` })} />
              </p>
              <p class="sec">{fill(T.inAccount, { amount: fmt(1001.85), days: fill(T.days, { count: 20 }) })}</p>
              <p class="stale">{T.confirmed}</p>
            </div>
          </div>

          <div class="scr">
            <div class="sh"><span>{T.recent}</span><small>{T.seeAll}</small></div>
            <div class="r ls-in" style="--d:.45s">
              <span class="ci" style="background:#C8F3E3"><i class="mdi mdi-file-document" /></span>
              <span class="rt"><b>Claude</b><small>{T.d15}</small></span>
              <span class="ra"><b>{fmt(18.37)}</b></span>
            </div>
            <div class="r ls-in" style="--d:.55s">
              <span class="ci" style="background:#F3E8C8"><i class="mdi mdi-gas-station" /></span>
              <span class="rt"><b>Decathlon</b><small>{T.d13}</small></span>
              <span class="ra"><b>{fmt(34.59)}</b></span>
            </div>
            <div class="r ls-in" style="--d:.65s">
              <span class="ci" style="background:#F3D9C8"><i class="mdi mdi-silverware-fork-knife" /></span>
              <span class="rt"><b>Aliexpress</b><small>{T.d12}</small></span>
              <span class="ra"><b>{fmt(69.36)}</b></span>
            </div>
            <div class="sh"><span>{T.upcoming}</span><small>{T.seeAll}</small></div>
            <div class="r ls-in" style="--d:.8s">
              <span class="ci" style="background:#C8F3E3">
                <i class="mdi mdi-file-document hb-glyph" />
                <i class="mdi mdi-check hb-check" />
              </span>
              <span class="rt"><b>Ultracc</b><small>{T.d1}</small></span>
              <span class="ra">
                <b>{fmt(8.94)}</b>
                <small class="hb-stat"><span class="hb-u">{T.unpaid}</span><span class="hb-p">{T.paid}</span></small>
              </span>
            </div>
            <div class="r ls-in" style="--d:.9s">
              <span class="ci" style="background:#C8F3E3"><i class="mdi mdi-file-document" /></span>
              <span class="rt"><b>Arche Training</b><small>{T.d1}</small></span>
              <span class="ra"><b>{fmt(260)}</b><small>{T.unpaid}</small></span>
            </div>
            <div class="r ls-in" style="--d:1s">
              <span class="ci" style="background:#C8F3E3"><i class="mdi mdi-file-document" /></span>
              <span class="rt"><b>Apple</b><small>{T.d1}</small></span>
              <span class="ra"><b>{fmt(2.99)}</b><small>{T.unpaid}</small></span>
            </div>
          </div>
        </>
      )
    }

    {/* ------------------------------------------- OVERVIEW: couple + spreadsheet */}
    {
      (kind === 'couple' || kind === 'spreadsheet') && (
        <>
          <div class="hd">
            <span class="month">{T.month} <i class="mdi mdi-chevron-down" /></span>
          </div>
          <div class="sw">
            <span>{T.workspace}</span>
            <i class="mdi mdi-account-multiple" />
          </div>
          <div class="bell">
            <i class="mdi mdi-bell-outline" />
            {kind === 'couple' && <span class="bd cp-badge">1</span>}
          </div>

          <div class="balwrap tight">
            <div class="balrow">
              <span class="ib"><i class="mdi mdi-eye-outline" /></span>
              {kind === 'couple' ? (
                <span class="amt">{fmt(5946.73)}</span>
              ) : (
                <span class="amt swapbox">
                  <span class="ss-a">{fmt(412.6)}</span>
                  <span class="ss-b">{fmt(411.3)}</span>
                </span>
              )}
              <span class="ib"><i class="mdi mdi-pencil-outline" /></span>
            </div>
            <p class="lbl">{kind === 'couple' ? T.total : T.avail} <i class="mdi mdi-chevron-down sm" /></p>
          </div>

          <div class="seg">
            {T.tabs.map((tab, i) => (
              <span class:list={['sg', { on: (kind === 'couple' ? 1 : 0) === i }]}>{tab}</span>
            ))}
          </div>
          <p class="hint">{hintOthers(kind === 'couple' ? T.othersExp : T.othersCat)}</p>

          <div class="scr pt12">
            {kind === 'couple' && (
              <>
                <div class="cp-banner">
                  <div class="cp-banner-in">
                    <div class="banner">
                      <span class="bic"><i class="mdi mdi-tag-outline" /></span>
                      <span class="bt"><b>{T.catTitle}</b><small>{T.catSub}</small></span>
                      <i class="mdi mdi-chevron-right" />
                    </div>
                  </div>
                </div>
                <div class="add">
                  <span class="ci add-c"><i class="mdi mdi-plus" /></span>
                  <span class="addl">{T.newExpense}</span>
                </div>
                <div class="cp-row">
                  <div class="cp-row-in">
                    <div class="r">
                      <span class="ci cpc">
                        <span class="cpc-un"><i class="mdi mdi-help-circle-outline" /></span>
                        <span class="cpc-ok"><i class="mdi mdi-cart" /></span>
                      </span>
                      <span class="rt"><b>{T.supermarket}</b><small>{T.d29}</small></span>
                      <span class="ra"><b>{fmt(24.5)}</b></span>
                    </div>
                  </div>
                </div>
                <div class="r">
                  <span class="ci" style="background:#F3C8C8"><i class="mdi mdi-heart" /></span>
                  <span class="rt"><b>{T.pharmacy}</b><small>{T.d28}</small></span>
                  <span class="ra"><b>{fmt(12.9)}</b></span>
                </div>
                <div class="r">
                  <span class="ci" style="background:#F3D9C8"><i class="mdi mdi-silverware-fork-knife" /></span>
                  <span class="rt"><b>{T.lunch}</b><small>{T.d28}</small></span>
                  <span class="ra"><b>{fmt(9.8)}</b></span>
                </div>
                <div class="r">
                  <span class="ci" style="background:#F3E8C8"><i class="mdi mdi-gas-station" /></span>
                  <span class="rt"><b>Galp</b><small>{T.d28}</small></span>
                  <span class="ra"><b>{fmt(35)}</b></span>
                </div>
              </>
            )}
            {kind === 'spreadsheet' && (
              <>
                <div class="add">
                  <span class="ci add-c"><i class="mdi mdi-plus" /></span>
                  <span class="addl">{T.newCat}</span>
                </div>
                {[
                  { n: T.billsCat, i: 'file-document', c: '#C8F3E3', s: 176, b: 950 },
                  { n: T.coffeeCat, i: 'silverware-fork-knife', c: '#F3D9C8', s: 25.4, o: 24.1, b: 150 },
                  { n: T.gasCat, i: 'gas-station', c: '#F3E8C8', s: 0, b: 80 },
                  { n: T.healthCat, i: 'heart', c: '#F3C8C8', s: 0, b: 60 },
                ].map((row) => (
                  <div class="r">
                    <span class="ci" style={`background:${row.c}`}><i class={`mdi mdi-${row.i}`} /></span>
                    <span class="rt"><b>{row.n}</b></span>
                    <span class="ra">
                      {row.o ? (
                        <b class="swapbox right">
                          <span class="ss-a">{fill(T.spent, { amount: fmt(row.o) })}</span>
                          <span class="ss-b">{fill(T.spent, { amount: fmt(row.s) })}</span>
                        </b>
                      ) : (
                        <b>{fill(T.spent, { amount: fmt(row.s) })}</b>
                      )}
                      <small>{fill(T.budget, { amount: fmt(row.b) })}</small>
                    </span>
                  </div>
                ))}
              </>
            )}
          </div>
        </>
      )
    }

    {/* ---------------------------------------------------- SAFE TO SPEND (payday) */}
    {
      kind === 'payday' && (
        <>
          <div class="nh">
            <i class="mdi mdi-chevron-left back" />
            <span class="ntitle">{T.sts}</span>
          </div>
          <div class="scr sts-pad">
            <p class="h26 ls-in" style="--d:.05s">{fill('{{amount}}/' + (en ? 'day' : 'dia'), { amount: fmt(104.77) })}</p>
            <p class="s14 ls-in" style="--d:.1s">{T.suffix}</p>
            <p class="s14 mb20 ls-in" style="--d:.15s">{fill(T.inAccount, { amount: fmt(1001.85), days: fill(T.days, { count: 23 }) })}</p>

            <p class="big ls-in" style="--d:.25s">{T.timeline}</p>
            <div class="tcard">
              <div class="tl ls-in" style="--d:.35s">
                <span class="rl"><i class="ln" /><i class="dt" /><i class="ln" /></span>
                <div class="tc">
                  <div class="dh"><span>{T.today}</span></div>
                  <div class="grp">
                    <span class="gc"><i class="mdi mdi-chevron-down g-down" /><i class="mdi mdi-chevron-up g-up" /></span>
