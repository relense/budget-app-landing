                        ))}
                      </div>
                      <div class="wbig2">
                        <em>{T.biggest}</em>
                        <p class="wh17">{T.rent}</p>
                        <p class="wcap">{fmt(796)} · {T.d9}</p>
                      </div>
                    </>
                  )}
                  {i === 3 && (
                    <>
                      <p class="eb">{T.billsLbl}</p>
                      <p class="wh22">{fill(T.paidOf, { paid: 14, total: 14 })}</p>
                      <p class="wcap">{T.allPaid}</p>
                    </>
