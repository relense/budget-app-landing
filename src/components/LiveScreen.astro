                  <div class="seg2 s3"><i class="pill" />{T.regions.map((o, i) => <span class:list={{ on: i === 0 }}>{o}</span>)}</div>
                  <p class="fl">{T.filing}</p>
                  <div class="seg2 s3 tall"><i class="pill" />{T.filings.map((o, i) => <span class:list={{ on: i === 0 }}>{o}</span>)}</div>
