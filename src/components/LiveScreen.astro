                      <span><b>{fmt(300)}</b><small>{T.ss}</small></span>
                      <span><b>{fmt(238)}</b><small>{T.irs}</small></span>
                      <span><b>{fmt(1462)}</b><small>{T.net}</small></span>
                    </div>
                  </div>
                </>
              ) : (
                <>
                  <p class="fl">{T.know}</p>
                  <div class="seg2 s2"><i class="pill" />{T.knowOpts.map((o, i) => <span class:list={{ on: i === 0 }}>{o}</span>)}</div>
                  <p class="fl">{T.grossMonthly}</p>
                  <div class="inp"><span class="eur">€</span><span class="ph">{en ? 'e.g. 1500' : 'ex.: 1500'}</span>
                    <span class="typed">{['1', '5', '0', '0'].map((c, i) => <em class={`c c${i}`}>{c}</em>)}</span>
                  </div>
