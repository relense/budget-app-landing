<script>
  // Play the set while it is on screen, and cheer whenever the calculator's numbers change.
  document.querySelectorAll<HTMLElement>('[data-tool-banner]').forEach((banner) => {
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => banner.classList.toggle('is-live', entry.isIntersecting), { threshold: 0.2 }).observe(banner);
    } else {
      banner.classList.add('is-live');
    }
    let timer = 0;
    document.addEventListener('tool:result', () => {
      banner.classList.remove('react');
      void banner.offsetWidth;
      banner.classList.add('react');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => banner.classList.remove('react'), 1500);
    });
  });
</script>

