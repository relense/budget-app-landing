---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [budgetByCategory, sharedWorkspaces, friends, planAhead] = t('featureGrid.cards');
---

<section id="features" class="bg-[var(--color-bg)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2
      class="max-w-[22ch] text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl"
      data-reveal
    >
      {t('featureGrid.heading')}
    </h2>

    <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div
        class="rounded-[var(--radius-card)] bg-[var(--color-mint)] p-7 sm:col-span-2 lg:col-span-2"
        data-reveal
      >
        <div
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[var(--color-mint-deep)]"
        >
          <Icon name="sliders-horizontal" class="h-5 w-5" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-mint-deep)]">{budgetByCategory.title}</h3>
        <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[var(--color-mint-deep)]">
          {budgetByCategory.body}
        </p>
      </div>

      <div
        class="rounded-[var(--radius-card)] bg-[var(--color-cat-blue-bg)] p-7 sm:col-span-2 lg:col-span-2"
        data-reveal
        style="transition-delay: 60ms"
      >
        <div
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[var(--color-cat-blue-icon)]"
        >
          <Icon name="users-three" class="h-5 w-5" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-cat-blue-icon)]">
          {sharedWorkspaces.title}
        </h3>
        <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[var(--color-cat-blue-icon)]">
          {sharedWorkspaces.body}
        </p>
      </div>

      <div
        class="rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:col-span-1 lg:col-span-1"
        data-reveal
        style="transition-delay: 120ms"
      >
        <div
          class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]"
        >
          <Icon name="user-plus" class="h-5 w-5" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-ink)]">{friends.title}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
          {friends.body}
        </p>
      </div>

      <div
        class="rounded-[var(--radius-card)] bg-[var(--color-cat-peach-bg)] p-7 sm:col-span-1 lg:col-span-3"
        data-reveal
        style="transition-delay: 180ms"
      >
        <div
          class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-[var(--color-cat-peach-icon)]"
        >
          <Icon name="calendar-blank" class="h-5 w-5" />
        </div>
        <h3 class="mt-6 text-xl font-medium text-[var(--color-cat-peach-icon)]">{planAhead.title}</h3>
        <p class="mt-2 max-w-[42ch] text-[15px] leading-relaxed text-[var(--color-cat-peach-icon)]">
          {planAhead.body}
        </p>
      </div>
    </div>
  </div>
</section>
