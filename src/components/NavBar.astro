---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

// `lang` prop lets a page force the chrome's language even when its own URL doesn't carry the
// `/pt-pt/` prefix `getLangFromUrl` looks for -- e.g. the flat, unprefixed `/ferramentas/*`
// calculator pages, which are Portuguese-only content by design (see their own page comments).
const { lang: langProp } = Astro.props as { lang?: Lang };
const lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/' : '/pt-pt/';
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-bg)]/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href={homeHref} class="flex items-center gap-2.5">
      <Image src={logo} alt="Otterbond" width={32} height={32} class="h-8 w-8" />
      <span class="text-lg font-medium text-[var(--color-ink)]">Otterbond</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a
        href={`${homeHref}#features`}
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >{t('nav.features')}</a
      >
      <a
        href={`${homeHref}#how-it-works`}
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >{t('nav.howItWorks')}</a
      >
      <a
        href={`${homeHref}#screens`}
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >{t('nav.screens')}</a
      >
      <a
        href={`${homeHref}#pricing`}
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >{t('nav.pricing')}</a
      >
      <a
        href={`${homeHref}#faq`}
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >{t('nav.faq')}</a
      >
    </div>

    <div class="hidden items-center md:flex">
      <a
        href={`${homeHref}#get-the-app`}
        class="rounded-full bg-[var(--color-pill)] px-5 py-2.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        {t('nav.getStarted')}
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      aria-label={t('nav.toggleMenu')}
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center text-[var(--color-ink)] md:hidden"
    >
      <Icon name="list" class="h-6 w-6" id="nav-icon-open" />
      <Icon name="x" class="hidden h-6 w-6" id="nav-icon-close" />
    </button>
  </nav>

  <div id="nav-panel" class="hidden border-t border-[var(--color-line)] px-5 pb-6 md:hidden">
    <div class="flex flex-col gap-1 pt-2">
      <a href={`${homeHref}#features`} class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >{t('nav.features')}</a
      >
      <a href={`${homeHref}#how-it-works`} class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >{t('nav.howItWorks')}</a
      >
      <a href={`${homeHref}#screens`} class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >{t('nav.screens')}</a
      >
      <a href={`${homeHref}#pricing`} class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >{t('nav.pricing')}</a
      >
      <a href={`${homeHref}#faq`} class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]">{t('nav.faq')}</a>
      <a
        href={`${homeHref}#get-the-app`}
        class="mt-2 rounded-full bg-[var(--color-pill)] px-5 py-3 text-center text-[15px] font-medium text-white"
      >
        {t('nav.getStarted')}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
