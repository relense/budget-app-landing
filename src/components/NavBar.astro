---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { WEB_APP_URL } from '../lib/constants';
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-white/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <Image src={logo} alt="Project Arwen" width={32} height={32} class="h-8 w-8" />
      <span class="text-lg font-medium text-[var(--color-ink)]">Project Arwen</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a
        href="#features"
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >Features</a
      >
      <a
        href="#how-it-works"
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >How it works</a
      >
      <a
        href="#screens"
        class="text-[15px] text-[var(--color-ink-soft)] transition-colors hover:text-[var(--color-ink)]"
        >Screens</a
      >
    </div>

    <div class="hidden items-center md:flex">
      <a
        href={WEB_APP_URL}
        class="rounded-full bg-[var(--color-pill)] px-5 py-2.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Get started
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center text-[var(--color-ink)] md:hidden"
    >
      <Icon name="list" class="h-6 w-6" id="nav-icon-open" />
      <Icon name="x" class="hidden h-6 w-6" id="nav-icon-close" />
    </button>
  </nav>

  <div id="nav-panel" class="hidden border-t border-[var(--color-line)] px-5 pb-6 md:hidden">
    <div class="flex flex-col gap-1 pt-2">
      <a href="#features" class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >Features</a
      >
      <a href="#how-it-works" class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >How it works</a
      >
      <a href="#screens" class="rounded-lg px-2 py-3 text-[15px] text-[var(--color-ink)]"
        >Screens</a
      >
      <a
        href={WEB_APP_URL}
        class="mt-2 rounded-full bg-[var(--color-pill)] px-5 py-3 text-center text-[15px] font-medium text-white"
      >
        Get started
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
