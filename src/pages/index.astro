---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import PortfolioNote from '../components/PortfolioNote.astro';
import GetTheApp from '../components/GetTheApp.astro';
import Faq from '../components/Faq.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';

// Deliberately no aggregateRating/review here: there are none yet, and inventing one would be
// exactly the kind of fake trust signal this project's own design rules ban.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Arwen',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web, iOS, Android',
  description:
    'A shared, multi-currency budget and savings tracker. Invite people you trust into a workspace, track expenses and recurring bills, and grow savings funds together.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
};
---

<BaseLayout>
  <NavBar />
  <main>
    <Hero />
    <TrustStrip />
    <HowItWorks />
    <FeatureGrid />
    <ScreenshotGallery />
    <PortfolioNote />
    <GetTheApp />
    <Faq />
    <Waitlist />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
</BaseLayout>
