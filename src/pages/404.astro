---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

// Static hosts only ever serve one root-level 404.html as the catch-all for unmatched
// routes, so a locale-prefixed /pt-pt/404 page wouldn't be reachable that way. This page
// stays English-only by design; it still detects `lang` so a stray direct link to
// /pt-pt/anything-that-doesn't-exist at least renders with the right <html lang>.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/' : '/pt-pt/';
---

<BaseLayout title={t('notFound.title')} description={t('notFound.description')}>
  <NavBar />
  <main class="flex min-h-[60vh] flex-col items-center justify-center px-5 py-24 text-center">
    <p class="font-mono text-sm text-[var(--color-ink-faint)]">404</p>
    <h1 class="mt-3 text-3xl font-medium text-[var(--color-ink)] sm:text-4xl">{t('notFound.heading')}</h1>
    <p class="mt-3 max-w-[46ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      {t('notFound.body')}
    </p>
    <a
      href={homeHref}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
    >
      {t('notFound.cta')}
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </main>
  <Footer />
</BaseLayout>
