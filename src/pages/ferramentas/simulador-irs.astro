---
// Standalone, Portuguese-only SEO tool page -- see recibos-verdes.astro's own comment for the
// shared "front door, not a feature of the app" rationale and the `lang`/`noAlternate` reasoning.
// No English counterpart (Portuguese tax rules only make sense in a Portuguese-language context).
//
// The most regulated page on the site so far -- see src/lib/calculators/irsCalculator.ts's own
// file comment for the full sourcing list. Seasonal: IRS filing season is April-June, so this
// page matters most Jan-Jun and should be reviewed every January for the new tax year's figures.
//
// `jointTaxation` (the calculator module's own clean boolean) is derived here from `maritalStatus`
// + a `spouseWorking` checkbox, mirroring recibos-verdes.astro's exact same UI pattern for the same
// underlying quociente-conjugal decision -- consistency with the one other page on this site that
// already asks this question the same way, rather than inventing a different framing.
//
// `irsRetainedDuringYear` defaults to an auto-estimate (salaryCalculator.ts's official 2026
// withholding tables, `annual.irs` at grossAnnualIncome/14) instead of a flat guessed number --
// added 2026-09-18 after user feedback that most people don't know this figure and a static
// default is actively misleading once it stops scaling with income. Stays auto-computed on every
// recalc until the user edits that field directly (`retainedManuallyEdited`), so someone who
// changed jobs mid-year (a real, common mismatch vs. the table estimate) can still override it,
// with a one-click "usar estimativa automática" reset back to the computed value.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Simulador de IRS 2026';
const description =
  'Estima se vais receber ou pagar IRS em 2026: rendimento coletável, escalão, dedução por dependentes e principais deduções à coleta. Resultado imediato, sem registo.';

const faqs = [
  {
    question: 'Isto substitui a simulação no Portal das Finanças?',
    answer:
      'Não. É uma estimativa rápida com as regras e os limites principais de 2026, mas não modela todas as deduções possíveis (por exemplo, PPR, doações, ascendentes a cargo, ou o regime de estudante deslocado), nem tem acesso às faturas que já entregaste. A simulação oficial na Declaração de IRS, feita com os teus dados reais, é sempre a que conta.',
  },
  {
    question: 'Tributação conjunta ou separada, qual escolher?',
    answer:
      'Em geral, a tributação conjunta favorece casais com rendimentos muito diferentes entre si (o quociente conjugal "empurra" o rendimento mais alto para um escalão mais baixo antes de calcular o imposto), enquanto casais com rendimentos parecidos raramente ganham muito com isso. Não há uma resposta universal -- em caso de dúvida, o Portal das Finanças permite simular os dois cenários antes de entregares.',
  },
  {
    question: 'Até quando tenho de entregar o IRS?',
    answer:
      'A entrega da Declaração de IRS decorre entre 1 de abril e 30 de junho, referente aos rendimentos do ano anterior. Quem tem a declaração automática validada pode nem precisar de fazer nada -- mas vale sempre a pena confirmar se todas as despesas dedutíveis foram corretamente registadas no e-fatura antes disso.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<BaseLayout title={title} description={description} lang="pt-pt" noAlternate>
  <NavBar lang="pt-pt" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Simulador de IRS 2026
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Introduz o teu rendimento e as principais despesas dedutíveis, e vê se deves esperar
      reembolso ou pagamento -- com os escalões de 2026 e a retenção de IRS estimada
      automaticamente a partir das tabelas oficiais, sem teres de a ir procurar ao recibo de
      vencimento.
    </p>
    <p class="mt-4 max-w-[60ch] rounded-xl bg-[var(--color-bg-elevated)] px-4 py-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
      Estimativa a partir de regras públicas, não é a tua declaração de IRS nem aconselhamento
      fiscal. Valores de 2026 (declaração a entregar entre abril e junho de 2027). Fonte: Código
      do IRS e Portal das Finanças.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Rendimento bruto anual (categoria A) (€)</span>
        <input
          type="number"
          id="grossAnnualIncome"
          value="25000"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">IRS retido durante o ano (€)</span>
        <input
          type="number"
          id="irsRetainedDuringYear"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
        <p class="mt-1.5 text-xs text-[var(--color-ink-faint)]">
          Estimado automaticamente a partir das tabelas de retenção na fonte de 2026 (rendimento,
          região e situação abaixo) -- não precisas de saber este valor de cor. Substitui-o se
          souberes o valor real (recibo de vencimento ou Declaração Mod. 3 pré-preenchida), por
          exemplo se mudaste de emprego a meio do ano.
          <button
            type="button"
            id="reset-retained"
            class="ml-1 cursor-pointer underline underline-offset-2"
          >
            Usar estimativa automática
          </button>
        </p>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Região</span>
        <select
          id="region"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="continente" selected>Continente</option>
          <option value="acores">Açores</option>
          <option value="madeira">Madeira</option>
        </select>
        <p class="mt-1.5 text-xs text-[var(--color-ink-faint)]">
          Só afeta a estimativa de retenção acima -- os escalões finais de IRS são os mesmos em
          todo o país.
        </p>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Estado civil</span>
        <select
          id="maritalStatus"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="single" selected>Solteiro / tributação separada</option>
          <option value="married">Casado / união de facto (tributação conjunta)</option>
        </select>
      </label>

      <label class="mt-1 flex items-center gap-2.5 text-sm" id="spouse-working-wrap" hidden>
        <input type="checkbox" id="spouseWorking" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
        <span class="text-[var(--color-ink)]">O cônjuge também trabalha e tem rendimentos</span>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Nº de dependentes</span>
        <input
          type="number"
          id="dependents"
          value="0"
          min="0"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">... dos quais com 6 anos ou menos</span>
        <input
          type="number"
          id="dependentsAgeSixOrUnder"
          value="0"
          min="0"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">... dos quais com menos de 3 anos</span>
        <input
          type="number"
          id="dependentsUnderThree"
          value="0"
          min="0"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Despesas dedutíveis (saúde, educação, habitação, gerais)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Despesas de saúde (€/ano)</span>
            <input
              type="number"
              id="healthExpenses"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Educação e formação (€/ano)</span>
            <input
              type="number"
              id="educationExpenses"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Renda de casa (habitação própria e permanente) (€/ano)</span>
            <input
              type="number"
              id="housingRent"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Juros de crédito habitação (contratos até 2011) (€/ano)</span>
            <input
              type="number"
              id="housingLoanInterest"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>
          <label class="block text-sm sm:col-span-2">
            <span class="font-medium text-[var(--color-ink)]">Despesas gerais familiares (€/ano)</span>
            <input
              type="number"
              id="generalFamilyExpenses"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
            <p class="mt-1.5 text-xs text-[var(--color-ink-faint)]">
              Água, luz, gás, telecomunicações, supermercado, combustível e outras não incluídas
              nas categorias acima.
            </p>
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-lg leading-snug font-medium text-[var(--color-mint-deep)]" id="result-headline"></p>
      <p class="mt-4 text-[15px] text-[var(--color-mint-deep)]/80" id="result-detail-1"></p>
      <p class="mt-1 text-[15px] text-[var(--color-mint-deep)]/80" id="result-detail-2"></p>
      <p class="mt-1 text-[15px] text-[var(--color-mint-deep)]/80" id="result-detail-3"></p>

      <details class="mt-5">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-mint-deep)]/70">
          Como calculámos
        </summary>
        <p class="mt-2 max-w-[58ch] text-sm leading-relaxed text-[var(--color-mint-deep)]/80">
          Rendimento coletável = rendimento bruto menos a dedução específica (mínimo 4.587,09€, ou
          11% do bruto se as contribuições obrigatórias para a Segurança Social forem maiores).
          Aplicam-se os escalões progressivos de 2026 a esse valor (a meias e a dobrar, se
          escolheres tributação conjunta). Ao imposto resultante subtraem-se a dedução por
          dependentes e as deduções à coleta (saúde, educação, habitação, despesas gerais), cada
          uma com o seu limite próprio, e todas juntas limitadas pelo limite global do art. 78º
          n.º 7 do Código do IRS. O que sobra é o imposto a pagar; a diferença para o que já foi
          retido é o teu reembolso ou pagamento adicional.
        </p>
        <p class="mt-3 max-w-[58ch] text-sm leading-relaxed text-[var(--color-mint-deep)]/80">
          O IRS retido é estimado a partir das tabelas oficiais de retenção na fonte de 2026
          (dividindo o rendimento anual por 14 pagamentos -- 12 meses mais os subsídios de férias
          e de Natal -- e aplicando a tabela do Continente, Açores ou Madeira consoante a região
          escolhida), a mesma fonte e método que usamos no simulador de Salário Líquido.
        </p>
      </details>
    </section>

    <div class="legal-body mt-14">
      <h2>Os escalões são progressivos, não um imposto fixo sobre tudo</h2>
      <p>
        Um erro comum é pensar que, ao entrares num escalão mais alto, todo o teu rendimento passa
        a ser taxado a essa taxa. Não é assim: cada escalão só se aplica à fatia do rendimento
        dentro desse intervalo. Se o teu rendimento coletável cair no 4º escalão, por exemplo, só
        essa fatia acima do 3º escalão paga a taxa do 4º -- o resto continua a pagar as taxas mais
        baixas dos escalões anteriores. É por isso que ganhar um pouco mais nunca te faz "perder
        dinheiro" por passar de escalão.
      </p>

      <h2>A dedução específica: o primeiro corte antes de qualquer cálculo</h2>
      <p>
        Antes de qualquer escalão entrar em jogo, o rendimento bruto de trabalho dependente tem
        direito a uma dedução específica automática -- em 2026, o maior valor entre 4.587,09€ e o
        total das tuas contribuições obrigatórias para a Segurança Social. Para a maioria dos
        trabalhadores, é o valor fixo que se aplica; só ultrapassa isso quem tem contribuições
        obrigatórias mais altas (por exemplo, ordens profissionais). Só depois deste corte é que
        se calcula o rendimento coletável, o valor efetivamente sujeito aos escalões.
      </p>

      <h2>Tributação conjunta vs. separada</h2>
      <p>
        Um casal pode escolher tributação separada (cada um entrega a sua declaração, com o seu
        próprio rendimento) ou conjunta (juntam os rendimentos, dividem por dois para efeitos de
        cálculo do escalão, e o imposto resultante é depois multiplicado por dois -- o "quociente
        conjugal"). Este mecanismo tende a beneficiar mais quem tem rendimentos muito diferentes
        entre si, porque "empurra" o rendimento mais alto para um escalão mais baixo antes do
        cálculo. Quando os dois rendimentos são parecidos, o benefício tende a ser pequeno ou nulo.
      </p>

      <h2>As deduções à coleta, e o limite que as junta a todas</h2>
      <p>
        Depois de calculado o imposto pelos escalões, ainda há deduções à coleta a subtrair:
        saúde (15% até 1.000€), educação e formação (30% até 800€), renda de casa (15% até 900€),
        juros de crédito habitação -- só para contratos celebrados até 2011 (15% até 296€), e
        despesas gerais familiares (35% até 250€ por sujeito passivo, 500€ em tributação conjunta).
        A soma de todas estas está sujeita a um limite global que depende do teu rendimento
        coletável: sem limite até 7.479€, entre 1.000€ e 2.500€ numa escala decrescente até
        78.834€, e fixo em 1.000€ acima disso. A dedução por dependente (600€ por dependente,
        mais para dependentes até 6 anos) é separada e não entra neste limite.
      </p>

      <h2>O que este simulador não modela</h2>
      <p>
        Não inclui PPR, donativos, o regime de estudante deslocado, ascendentes a cargo, nem
        situações de residente não habitual ou regimes especiais. Também assume rendimento
        exclusivamente de categoria A (trabalho dependente) -- rendimentos prediais, de capitais
        ou mais-valias não estão contemplados. Para a tua situação real e completa, a Declaração
        de IRS no Portal das Finanças continua a ser a referência.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Ferramentas relacionadas</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <a
          href="/ferramentas/salario-liquido"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="check-circle" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Salário Líquido</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Confirma quanto do teu salário bruto realmente chega à conta todos os meses.
          </p>
        </a>
        <a
          href="/ferramentas/fundo-de-emergencia"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="shield-check" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Fundo de Emergência</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Se vais ter reembolso, aqui está um destino óbvio para ele.
          </p>
        </a>
      </div>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="receipt" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]" id="bridge-headline">
        Já sabes a estimativa. Falta decidir o que fazer com ela.
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]" id="bridge-body">
        O Otterbond ajuda-te a planear com antecedência, seja para guardar um reembolso ou para
        te preparares para um pagamento.
      </p>
      <a
        id="bridge-cta"
        href="/pt-pt/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Experimentar grátis
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>

    <p class="mt-8 max-w-[60ch] text-xs leading-relaxed text-[var(--color-ink-faint)]">
      Estimativa a partir de regras públicas do Código do IRS, não é aconselhamento fiscal, legal
      ou financeiro, nem substitui a tua declaração de IRS.
    </p>
  </main>

  <Footer lang="pt-pt" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd)} />
</BaseLayout>

<script>
  import { calculateIrs } from '../../lib/calculators/irsCalculator';
  import { calculateSalary, type FilingStatus, type Region } from '../../lib/calculators/salaryCalculator';

  const TOOL_SLUG = 'simulador-irs';

  function trackEvent(name: string) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, { tool: TOOL_SLUG });
    }
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function checked(id: string): boolean {
    return (document.getElementById(id) as HTMLInputElement).checked;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLSelectElement).value;
  }

  const maritalStatusSelect = document.getElementById('maritalStatus') as HTMLSelectElement;
  const spouseWorkingWrap = document.getElementById('spouse-working-wrap') as HTMLElement;
  const retainedInput = document.getElementById('irsRetainedDuringYear') as HTMLInputElement;

  function syncVisibility() {
    spouseWorkingWrap.hidden = maritalStatusSelect.value !== 'married';
  }

  // Withholding tables only distinguish "sole earner" households from everyone else -- a married
  // filer whose spouse also works uses the exact same table as a single filer (see
  // salaryCalculator.ts's own Table I comment), so there's no separate "married, two earners"
  // option here, mirroring salario-liquido.astro's own filingStatus select.
  function toFilingStatus(maritalStatus: 'single' | 'married', spouseWorking: boolean): FilingStatus {
    return maritalStatus === 'married' && !spouseWorking ? 'marriedOneEarner' : 'single';
  }

  // Estimates the year's total withheld IRS from the official 2026 withholding tables, so the
  // "IRS retido" field has an accurate, income-scaled default instead of an arbitrary flat number
  // -- most people don't know this figure off-hand. Divides by 14 (12 months + 2 subsidies), the
  // same annual-payment assumption salaryCalculator.ts itself makes.
  function computeSuggestedRetention(): number {
    const grossAnnual = num('grossAnnualIncome');
    if (grossAnnual <= 0) return 0;
    const result = calculateSalary({
      direction: 'grossToNet',
      amount: grossAnnual / 14,
      region: val('region') as Region,
      filingStatus: toFilingStatus(val('maritalStatus') as 'single' | 'married', checked('spouseWorking')),
      dependents: num('dependents'),
      disabled: false,
      mealAllowance: null,
    });
    return Math.round(result.annual.irs);
  }

  let retainedManuallyEdited = false;

  function recalc() {
    syncVisibility();

    if (!retainedManuallyEdited) {
      retainedInput.value = String(computeSuggestedRetention());
    }

    const maritalStatus = val('maritalStatus') as 'single' | 'married';
    const jointTaxation = maritalStatus === 'married' && !checked('spouseWorking');

    const result = calculateIrs({
      taxYear: 2026,
      grossAnnualIncome: num('grossAnnualIncome'),
      maritalStatus,
      jointTaxation,
      dependents: num('dependents'),
      dependentsAgeSixOrUnder: num('dependentsAgeSixOrUnder'),
      dependentsUnderThree: num('dependentsUnderThree'),
      irsRetainedDuringYear: num('irsRetainedDuringYear'),
      healthExpenses: num('healthExpenses'),
      educationExpenses: num('educationExpenses'),
      housingRent: num('housingRent'),
      housingLoanInterest: num('housingLoanInterest'),
      generalFamilyExpenses: num('generalFamilyExpenses'),
    });

    const headline = document.getElementById('result-headline')!;
    const bridgeHeadline = document.getElementById('bridge-headline')!;
    const bridgeBody = document.getElementById('bridge-body')!;

    if (Math.round(result.balance) === 0) {
      headline.textContent = 'As contas ficam certas: nem reembolso, nem pagamento.';
      bridgeHeadline.textContent = 'Já sabes a estimativa. Falta decidir o que fazer com ela.';
      bridgeBody.textContent =
        'O Otterbond ajuda-te a planear com antecedência, seja para guardar um reembolso ou para te preparares para um pagamento.';
    } else if (result.balance > 0) {
      headline.textContent = `Estimativa: recebes cerca de ${euro.format(result.balance)}.`;
      bridgeHeadline.textContent = `Vais receber cerca de ${euro.format(result.balance)}. Já sabes o que vais fazer com isso?`;
      bridgeBody.textContent = 'O Otterbond ajuda-te a criar um fundo para o reembolso não se perder no dia a dia.';
    } else {
      headline.textContent = `Estimativa: pagas cerca de ${euro.format(-result.balance)}.`;
      bridgeHeadline.textContent = `Vais ter de pagar cerca de ${euro.format(-result.balance)}. Prepara-te com antecedência.`;
      bridgeBody.textContent = 'O Otterbond ajuda-te a separar esse valor mês a mês, antes de o pagamento chegar.';
    }

    document.getElementById('result-detail-1')!.textContent =
      `Rendimento coletável: ${euro.format(result.taxableIncome)}/ano · Imposto antes de deduções: ${euro.format(result.taxBeforeCredits)}`;
    document.getElementById('result-detail-2')!.textContent =
      `Dedução por dependentes: ${euro.format(result.dependentsDeduction)} · Deduções à coleta aplicadas: ${euro.format(result.deductionsACollectaApplied)}`;
    document.getElementById('result-detail-3')!.textContent = `Imposto a pagar: ${euro.format(result.taxDue)}`;
  }

  let hasFiredCompleted = false;
  form.addEventListener('input', (event) => {
    if ((event.target as HTMLElement)?.id === 'irsRetainedDuringYear') {
      retainedManuallyEdited = true;
    }
    if (!hasFiredCompleted) {
      hasFiredCompleted = true;
      trackEvent('tool_completed');
    }
    recalc();
  });

  document.getElementById('reset-retained')?.addEventListener('click', () => {
    retainedManuallyEdited = false;
    recalc();
  });

  recalc();
  trackEvent('tool_view');

  document.getElementById('bridge-cta')?.addEventListener('click', () => trackEvent('tool_bridge_click'));
</script>
