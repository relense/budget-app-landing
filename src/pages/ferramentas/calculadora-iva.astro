---
// Standalone, Portuguese-only SEO tool page -- see recibos-verdes.astro's own comment for the
// shared "front door, not a feature of the app" rationale and the `lang`/`noAlternate` reasoning.
// No English counterpart yet.
//
// The simplest tool in this batch -- trivial arithmetic, no bracket tables, no real sourcing risk
// beyond the three regions' rate tables themselves. See
// src/lib/calculators/vatCalculator.ts's own comment for those.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Calculadora de IVA 2026';
const description =
  'Calcula o IVA a somar ou a extrair de um valor, com as taxas de 2026 para Continente, Açores e Madeira. Resultado imediato, sem registo.';

const faqs = [
  {
    question: 'Que bens e serviços pagam cada taxa?',
    answer:
      'A taxa reduzida (6% no Continente) aplica-se a bens de primeira necessidade -- pão, leite, carne, peixe, medicamentos, alojamento hoteleiro, entre outros da Lista I do Código do IVA. A taxa intermédia (13%) cobre uma lista mais restrita, como certas refeições prontas ou entradas em espetáculos. A taxa normal (23%) aplica-se a tudo o resto.',
  },
  {
    question: 'Trabalho a recibos verdes -- tenho de cobrar IVA?',
    answer:
      'Só se ultrapassares 15.000€ de volume de negócios no ano anterior (regime do artigo 53º do CIVA, isenção para pequenos sujeitos passivos). Abaixo desse limite, podes optar por não liquidar IVA nas tuas faturas -- mas também não deduzes o IVA das tuas compras. Ultrapassar 18.750€ (15.000€ + 25%) a meio do ano obriga a sair do regime de imediato.',
  },
  {
    question: 'Como funciona o IVA trimestral?',
    answer:
      'Para a maioria dos sujeitos passivos no regime normal, a entrega da declaração periódica de IVA é trimestral -- até ao dia 20 do 2º mês seguinte ao trimestre a que respeita. Empresas com volume de negócios mais alto passam ao regime mensal. Isto aplica-se a quem liquida IVA, não a quem está isento pelo artigo 53º.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<BaseLayout title={title} description={description} lang="pt-pt">
  <NavBar lang="pt-pt" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Calculadora de IVA
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Soma ou extrai o IVA de um valor, com as taxas de 2026 para o Continente, Açores e Madeira.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Valor (€)</span>
        <input
          type="number"
          id="amount"
          value="100"
          min="0"
          step="0.01"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Direção</span>
        <select
          id="direction"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="add" selected>Somar IVA (valor sem IVA → com IVA)</option>
          <option value="extract">Extrair IVA (valor com IVA → sem IVA)</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Região</span>
        <select
          id="region"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="continente" selected>Continente</option>
          <option value="acores">Açores</option>
          <option value="madeira">Madeira</option>
        </select>
      </label>

      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Taxa</span>
        <select
          id="rateTier"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="normal" selected>Normal</option>
          <option value="intermedia">Intermédia</option>
          <option value="reduzida">Reduzida</option>
        </select>
        <p class="mt-1.5 text-xs text-[var(--color-ink-faint)]" id="rate-caption"></p>
      </label>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-lg leading-snug font-medium text-[var(--color-mint-deep)]" id="result-headline"></p>
      <p class="mt-4 text-[15px] text-[var(--color-mint-deep)]/80" id="result-detail"></p>
    </section>

    <div class="legal-body mt-14">
      <h2>As três taxas, e o que cada uma cobre</h2>
      <p>
        Portugal tem três taxas de IVA, diferentes consoante a região: no Continente, 23% (normal),
        13% (intermédia) e 6% (reduzida). Nos Açores, 16%, 9% e 4%. Na Madeira, 22%, 12% e 4%. A
        taxa reduzida cobre bens essenciais -- alimentação básica, medicamentos, alojamento
        hoteleiro. A intermédia cobre uma lista mais restrita e específica. A normal aplica-se a
        tudo o que não está nas outras duas listas.
      </p>

      <h2>A isenção para pequenos sujeitos passivos</h2>
      <p>
        Quem trabalha a recibos verdes e fatura até 15.000€ por ano pode optar por não liquidar
        IVA nas suas faturas, ao abrigo do artigo 53º do Código do IVA -- mas, em troca, também não
        deduz o IVA das suas próprias compras e despesas. Ultrapassar 18.750€ (15.000€ mais uma
        margem de tolerância de 25%) a meio do ano obriga a sair do regime de isenção
        imediatamente; ultrapassar apenas os 15.000€ sem chegar aos 18.750€ mantém a isenção até ao
        fim do ano corrente, mudando para o regime normal em janeiro seguinte.
      </p>

      <h2>Como funciona o IVA trimestral</h2>
      <p>
        Para quem liquida IVA no regime normal, a declaração periódica é entregue trimestralmente
        (até ao dia 20 do 2º mês após o fim do trimestre), a não ser que o volume de negócios
        obrigue ao regime mensal. Isto não se aplica a quem está isento pelo artigo 53º -- essas
        entidades não entregam declarações periódicas de IVA.
      </p>

      <h2>O que esta calculadora não faz</h2>
      <p>
        Não determina que taxa se aplica a um bem ou serviço específico -- isso depende das Listas
        I e II do Código do IVA, que esta calculadora não reproduz. Também não modela o regime de
        isenção do artigo 53º em detalhe, apenas o cálculo direto de somar ou extrair IVA a partir
        de uma taxa que já sabes.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Ferramentas relacionadas</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <a
          href="/ferramentas/recibos-verdes"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="coins" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Simulador de Recibos Verdes</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Trabalhas a recibos verdes? Simula o teu rendimento líquido completo.
          </p>
        </a>
        <a
          href="/ferramentas/regra-50-30-20"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="chart-pie" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Regra 50/30/20</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Organiza o resto do teu rendimento depois de contas feitas.
          </p>
        </a>
      </div>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="percent" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        Já sabes as contas do IVA. Falta organizar o resto.
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        O Otterbond ajuda trabalhadores independentes a separar o que é para impostos do que é
        para gastar.
      </p>
      <a
        id="bridge-cta"
        href="/pt-pt/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Experimentar grátis
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>

    <p class="mt-8 max-w-[60ch] text-xs leading-relaxed text-[var(--color-ink-faint)]">
      Estimativa a partir das taxas de IVA de 2026, não é aconselhamento fiscal.
    </p>
  </main>

  <Footer lang="pt-pt" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd)} />
</BaseLayout>

<script>
  import { calculateVat, type VatDirection, type VatRateTier, type VatRegion } from '../../lib/calculators/vatCalculator';

  const TOOL_SLUG = 'calculadora-iva';

  function trackEvent(name: string) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, { tool: TOOL_SLUG });
    }
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLSelectElement).value;
  }

  function recalc() {
    const result = calculateVat({
      amount: num('amount'),
      direction: val('direction') as VatDirection,
      region: val('region') as VatRegion,
      rateTier: val('rateTier') as VatRateTier,
    });

    document.getElementById('rate-caption')!.textContent = `Taxa aplicada: ${result.ratePercent}%`;

    document.getElementById('result-headline')!.textContent =
      `${euro.format(result.net)} sem IVA + ${euro.format(result.vat)} de IVA = ${euro.format(result.gross)} com IVA.`;
    document.getElementById('result-detail')!.textContent = `Taxa aplicada: ${result.ratePercent}%.`;
  }

  let hasFiredCompleted = false;
  form.addEventListener('input', () => {
    if (!hasFiredCompleted) {
      hasFiredCompleted = true;
      trackEvent('tool_completed');
    }
    recalc();
  });

  recalc();
  trackEvent('tool_view');

  document.getElementById('bridge-cta')?.addEventListener('click', () => trackEvent('tool_bridge_click'));
</script>
