---
// Standalone, Portuguese-only SEO tool page -- see this repo's docs/PLAN.md-adjacent session
// notes for the "front door, not a feature of the app" rationale: someone searching "simulador
// recibos verdes" doesn't know or care what Otterbond is yet, so this page's job is to answer
// their actual question fast, rank well doing it, and only then offer the app as the next step.
// `lang="pt-pt"` + `noAlternate` on BaseLayout for the same reason as juros-compostos.astro: this
// URL has no `/pt-pt/` prefix and no true bilingual counterpart at a mirrored path. There IS now an
// English counterpart for the same underlying tax rules, framed for expats rather than a literal
// translation of "recibos verdes": /tools/portugal-freelancer-tax-calculator.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Recibos Verdes / Trabalhador Independente 2026';
const description =
  'Calculadora de impostos para trabalhador independente (recibos verdes) em Portugal: IRS retido, Segurança Social, regime simplificado, isenção do 1º ano em 2026. Sem registo.';

const faqs = [
  {
    question: '"Recibos verdes" e "trabalhador independente" são a mesma coisa?',
    answer:
      'Sim, no dia a dia usa-se "recibos verdes" para falar de quem trabalha como trabalhador independente em Portugal (Categoria B de IRS), emitindo recibos através do Portal das Finanças em vez de receber um salário com desconto na fonte. "Recibos verdes" é o termo coloquial, "trabalhador independente" é o termo oficial, esta calculadora serve para os dois.',
  },
  {
    question: 'Que impostos paga um trabalhador independente em Portugal?',
    answer:
      'Dois principais: IRS (Categoria B, retido a cada recibo ou pago por conta) e Segurança Social (21,4% sobre 70% do rendimento relevante dos últimos três meses, com isenção geralmente no primeiro ano de atividade). Pode ainda haver IVA, dependendo do rendimento anual, ver a pergunta seguinte.',
  },
  {
    question: 'Quando é que um trabalhador independente está isento de IVA?',
    answer:
      'Quem prevê (ou faturou no ano anterior) menos de €15.000 está, regra geral, automaticamente enquadrado no regime de isenção de IVA (artigo 53º do Código do IVA): não liquida IVA nos recibos nem o entrega ao Estado, mas também não pode deduzir o IVA de despesas do negócio. Acima desse limiar, ou por opção própria, passa a haver liquidação normal.',
  },
  {
    question: 'Um trabalhador independente precisa sempre de contabilista?',
    answer:
      'Não é obrigatório por lei ter contabilista certificado enquanto o regime for simplificado, mas é obrigatório a partir do momento em que se transita para contabilidade organizada (geralmente acima de €200.000 de rendimento anual, ou por opção própria). Mesmo sem essa obrigação, muita gente contrata um contabilista para garantir que o enquadramento e as entregas (IVA, retenções) estão corretos.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout title={title} description={description} lang="pt-pt">
  <NavBar lang="pt-pt" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Simulador de Recibos Verdes 2026
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Calculadora de impostos para quem trabalha a recibos verdes (trabalhador independente):
      indica o teu rendimento e vê uma estimativa do IRS retido, da Segurança Social e do valor
      líquido, com as regras de 2026 (regime simplificado, Categoria B).
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Rendimento</span>
        <div class="mt-1.5 flex gap-2">
          <input
            type="number"
            id="income"
            value="2000"
            min="0"
            step="1"
            class="w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
          />
          <select
            id="incomeFrequency"
            class="rounded-xl border border-black/10 bg-white px-3 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
          >
            <option value="month" selected>por mês</option>
            <option value="year">por ano</option>
            <option value="day">por dia</option>
          </select>
        </div>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Regime simplificado</span>
        <select
          id="simplifiedRegimeYear"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="standard" selected>Ano padrão (coeficiente 75%)</option>
          <option value="firstYear">1º ano de atividade (37,5%)</option>
          <option value="secondYear">2º ano de atividade (56,25%)</option>
        </select>
      </label>

      <label class="mt-1 flex items-center gap-2.5 text-sm sm:mt-6">
        <input
          type="checkbox"
          id="socialSecurityFirstYearExempt"
          class="h-4 w-4 rounded accent-[var(--color-mint-deep)]"
        />
        <span class="text-[var(--color-ink)]">Isento de Segurança Social (1º ano de atividade)</span>
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Opções avançadas (dependentes, estado civil, RNH, IRS Jovem...)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Dias sem atividade (além dos 248 dias úteis)</span>
            <input
              type="number"
              id="daysOff"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Ajuste à base de incidência da SS</span>
            <select
              id="socialSecurityDiscount"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="-0.25">-25%</option>
              <option value="-0.2">-20%</option>
              <option value="-0.15">-15%</option>
              <option value="-0.1">-10%</option>
              <option value="-0.05">-5%</option>
              <option value="0" selected>Sem ajuste</option>
              <option value="0.05">+5%</option>
              <option value="0.1">+10%</option>
              <option value="0.15">+15%</option>
              <option value="0.2">+20%</option>
              <option value="0.25">+25%</option>
            </select>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Despesas reais documentadas (€/ano)</span>
            <input
              type="number"
              id="expenses"
              placeholder="Deixa em branco para calcular automaticamente"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none placeholder:text-[var(--color-placeholder)] focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Estado civil</span>
            <select
              id="maritalStatus"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="single" selected>Solteiro / tributação separada</option>
              <option value="married">Casado / união de facto (tributação conjunta)</option>
            </select>
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm" id="spouse-working-wrap" hidden>
            <input type="checkbox" id="spouseWorking" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">O cônjuge também trabalha e tem rendimentos</span>
          </label>

          <label class="block text-sm" id="spouse-income-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Rendimento coletável anual do cônjuge (€)</span>
            <input
              type="number"
              id="spouseTaxableIncome"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Nº de dependentes</span>
            <input
              type="number"
              id="dependents"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">... dos quais com 6 anos ou menos</span>
            <input
              type="number"
              id="dependentsAgeSixOrUnder"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">... dos quais com menos de 3 anos</span>
            <input
              type="number"
              id="dependentsUnderThree"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm">
            <input type="checkbox" id="nonHabitualResident" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">Residente Não Habitual (RNH, taxa fixa de 20%)</span>
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm">
            <input type="checkbox" id="youthIrsEnabled" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">IRS Jovem</span>
          </label>

          <label class="block text-sm" id="youth-year-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Que ano do benefício?</span>
            <select
              id="youthIrsBenefitYear"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => <option value={n}>{n}º ano</option>)}
            </select>
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-[var(--color-mint-deep)]/70">Valor líquido estimado / mês</p>
      <p class="mt-1 text-4xl font-medium text-[var(--color-mint-deep)]" id="result-net">€0</p>

      <div class="mt-5 grid grid-cols-2 gap-4 text-[15px] text-[var(--color-mint-deep)] sm:grid-cols-3">
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Rendimento bruto</p>
          <p class="font-medium" id="result-gross">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">IRS retido</p>
          <p class="font-medium" id="result-irs">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Segurança Social</p>
          <p class="font-medium" id="result-ss">€0</p>
        </div>
      </div>

      <p class="mt-5 text-sm text-[var(--color-mint-deep)]/80" id="result-detail"></p>
    </section>

    <div class="legal-body mt-14">
      <h2>Como é calculado o líquido em recibos verdes</h2>
      <p>
        Em regime simplificado (Categoria B), a Autoridade Tributária não tributa o rendimento
        bruto diretamente. Primeiro aplica-se um coeficiente ao rendimento bruto anual, 75% no
        regime padrão, para chegar ao rendimento coletável, que é depois sujeito aos escalões
        progressivos de IRS. A Segurança Social é calculada em separado, sobre 70% do rendimento
        relevante dos últimos três meses (com um teto de 12x o IAS por ano).
      </p>
      <p>
        Este simulador aplica o método oficial simplificado de "taxa média + taxa marginal": até
        ao limite do escalão anterior aplica-se a taxa média acumulada desse escalão, e só o
        excedente é tributado à taxa marginal do escalão em que o rendimento coletável cai. É o
        mesmo método usado nas tabelas oficiais de retenção.
      </p>

      <h2>Regime simplificado: os coeficientes reduzidos do 1º e 2º ano</h2>
      <p>
        Quem está a começar tem um coeficiente reduzido nos dois primeiros anos de atividade:
        37,5% no primeiro ano e 56,25% no segundo, em vez dos 75% habituais, o que reduz bastante o
        rendimento coletável (e por isso o IRS) nesse período. A partir do terceiro ano aplica-se o
        coeficiente padrão de 75%.
      </p>

      <h2>Isenção de Segurança Social no primeiro ano</h2>
      <p>
        Quem abre atividade como trabalhador independente pela primeira vez tem, geralmente, uma
        isenção de contribuições para a Segurança Social nos primeiros 12 meses de atividade. Após
        esse período, a contribuição passa a ser calculada normalmente (21,4% sobre 70% do
        rendimento relevante, com um mínimo mensal). Este simulador modela essa isenção como uma
        opção que podes ativar ou desativar.
      </p>

      <h2>Isenção de IVA (e porque não entra nesta conta)</h2>
      <p>
        Quem fatura recibos verdes e prevê (ou faturou no ano anterior) menos de €15.000 está,
        regra geral, automaticamente enquadrado no regime de isenção de IVA (artigo 53º do Código
        do IVA), o que significa não liquidar IVA nos recibos nem o entregar ao Estado, mas também
        não poder deduzir o IVA de despesas do negócio. Ultrapassado esse limiar, ou por opção
        própria, passa a haver liquidação normal de IVA. Este simulador foca-se apenas em IRS e
        Segurança Social, o IVA não afeta o valor líquido que fica no teu bolso da mesma forma que
        o rendimento tributável em IRS, por isso não entra nesta conta.
      </p>

      <h2>O que este simulador não substitui</h2>
      <p>
        Os valores aqui são uma estimativa cuidada, baseada nas tabelas e fórmulas oficiais de
        2026, mas não têm em conta toda e qualquer particularidade da tua situação (por exemplo,
        deduções específicas, ascendentes a cargo, ou regimes especiais menos comuns). Para a tua
        declaração de IRS, ou para decisões que dependam de um valor exato, fala com um
        contabilista certificado.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="coins" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        Já sabes quanto fica líquido. Sabes quanto podes gastar por dia até ao próximo pagamento?
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        O Otterbond faz essa conta todas as manhãs, e guarda automaticamente o que precisas para o
        IRS e a Segurança Social.
      </p>
      <a
        href="/pt-pt/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Experimentar grátis
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>
  </main>

  <Footer lang="pt-pt" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<script>
  import {
    calculateFreelancerTaxes,
    DEFAULT_TAX_YEAR,
    type IncomeFrequency,
    type SimplifiedRegimeYear,
    type MaritalStatus,
  } from '../../lib/calculators/taxCalculator';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const pct = new Intl.NumberFormat('pt-PT', { style: 'percent', maximumFractionDigits: 1 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function checked(id: string): boolean {
    return (document.getElementById(id) as HTMLInputElement).checked;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value;
  }

  const maritalStatusSelect = document.getElementById('maritalStatus') as HTMLSelectElement;
  const spouseWorkingWrap = document.getElementById('spouse-working-wrap') as HTMLElement;
  const spouseIncomeWrap = document.getElementById('spouse-income-wrap') as HTMLElement;
  const youthEnabledInput = document.getElementById('youthIrsEnabled') as HTMLInputElement;
  const youthYearWrap = document.getElementById('youth-year-wrap') as HTMLElement;

  function syncVisibility() {
    const married = maritalStatusSelect.value === 'married';
    spouseWorkingWrap.hidden = !married;
    spouseIncomeWrap.hidden = !married || !checked('spouseWorking');
    youthYearWrap.hidden = !youthEnabledInput.checked;
  }

  function recalc() {
    syncVisibility();

    const result = calculateFreelancerTaxes({
      income: num('income'),
      incomeFrequency: val('incomeFrequency') as IncomeFrequency,
      taxYear: DEFAULT_TAX_YEAR,
      daysOff: num('daysOff'),
      socialSecurityDiscount: Number(val('socialSecurityDiscount')),
      socialSecurityFirstYearExempt: checked('socialSecurityFirstYearExempt'),
      simplifiedRegimeYear: val('simplifiedRegimeYear') as SimplifiedRegimeYear,
      expenses: val('expenses') === '' ? null : num('expenses'),
      nonHabitualResident: checked('nonHabitualResident'),
      youthIrs: youthEnabledInput.checked
        ? { enabled: true, benefitYear: num('youthIrsBenefitYear') || 1 }
        : null,
      maritalStatus: val('maritalStatus') as MaritalStatus,
      spouseWorking: checked('spouseWorking'),
      spouseTaxableIncome: num('spouseTaxableIncome'),
      dependents: num('dependents'),
      dependentsAgeSixOrUnder: num('dependentsAgeSixOrUnder'),
      dependentsUnderThree: num('dependentsUnderThree'),
    });

    document.getElementById('result-net')!.textContent = euro.format(result.netIncome.month);
    document.getElementById('result-gross')!.textContent = euro.format(result.grossIncome.month);
    document.getElementById('result-irs')!.textContent = euro.format(result.irs.month);
    document.getElementById('result-ss')!.textContent = euro.format(result.socialSecurity.month);

    const detail = document.getElementById('result-detail')!;
    if (result.bracket) {
      detail.textContent = `Rendimento coletável: ${euro.format(result.taxableIncome)}/ano · Escalão de IRS: ${pct.format(result.bracket.normalRate)}${result.jointTaxationApplied ? ' · tributação conjunta aplicada' : ''}`;
    } else {
      detail.textContent = '';
    }
  }

  form.addEventListener('input', recalc);
  recalc();
</script>
