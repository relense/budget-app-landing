---
// Standalone, Portuguese-only SEO tool page -- see recibos-verdes.astro's own comment for the
// shared "front door, not a feature of the app" rationale and the `lang`/`noAlternate` reasoning.
// No English counterpart yet.
//
// Deliberately reuses salaryCalculator.ts's `calculateSalary` directly (same inputs as
// salario-liquido.astro) rather than a separate net-salary calculation -- this page's own new code
// is only `paySchedule.ts`'s 12-month calendar mapping on top of that existing result. Keeps the
// two pages' numbers from ever silently diverging.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Subsídio de Férias e Natal: pagamento único ou duodécimos';
const description =
  'Vê quanto recebes em cada mês do ano com os subsídios de férias e Natal, a pagamento único ou espalhados por duodécimos. Resultado imediato, sem registo.';

const faqs = [
  {
    question: 'Tenho sempre direito aos dois subsídios?',
    answer:
      'Sim -- o subsídio de férias e o subsídio de Natal são um direito legal de qualquer trabalhador por conta de outrem em Portugal, cada um no valor de um mês de retribuição base (mais eventuais outras prestações regulares). No primeiro ano de trabalho, o valor é proporcional ao tempo de serviço nesse ano civil.',
  },
  {
    question: 'Posso escolher duodécimos a meio do ano?',
    answer:
      'A opção por duodécimos é feita normalmente por comunicação ao empregador até 31 de outubro do ano anterior, para produzir efeitos a partir de 1 de janeiro seguinte -- não é algo que se ative a meio do ano corrente. Consulta o teu departamento de RH sobre o prazo e o processo exatos na tua empresa.',
  },
  {
    question: 'Os subsídios são tributados da mesma forma que o salário normal?',
    answer:
      'Não exatamente -- cada subsídio é retido na fonte de forma autónoma, à taxa que se aplicaria se todo o valor do subsídio fosse pago de uma vez (mesmo em duodécimos, o cálculo da retenção usa o valor completo do subsídio, só o pagamento é que fica espalhado). Não há subsídio de alimentação associado ao pagamento do subsídio em si.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};

const monthLabels = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];
---

<BaseLayout title={title} description={description} lang="pt-pt">
  <NavBar lang="pt-pt" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Subsídio de Férias e Natal
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Vê exatamente quanto cai na tua conta em cada mês do ano -- a pagamento único em junho e
      novembro, ou espalhado por duodécimos ao longo dos 12 meses.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Salário base mensal bruto (€)</span>
        <input
          type="number"
          id="amount"
          value="1500"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Forma de pagamento</span>
        <select
          id="paymentMode"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="lumpSum" selected>Pagamento único (junho e novembro)</option>
          <option value="duodecimos">Duodécimos (espalhado pelos 12 meses)</option>
        </select>
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Opções avançadas (região, estado civil, dependentes)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Região</span>
            <select
              id="region"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="continente" selected>Continente</option>
              <option value="acores">Açores</option>
              <option value="madeira">Madeira</option>
            </select>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Estado civil</span>
            <select
              id="filingStatus"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="single" selected>Solteiro / casado, dois titulares</option>
              <option value="marriedOneEarner">Casado, um titular</option>
            </select>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Nº de dependentes</span>
            <input
              type="number"
              id="dependents"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-lg leading-snug font-medium text-[var(--color-mint-deep)]" id="result-headline"></p>

      <div class="mt-5 grid grid-cols-3 gap-2.5 sm:grid-cols-6" id="calendar-grid"></div>

      <details class="mt-5">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-mint-deep)]/70">
          Como calculámos
        </summary>
        <p class="mt-2 max-w-[58ch] text-sm leading-relaxed text-[var(--color-mint-deep)]/80">
          Cada subsídio é retido na fonte como se fosse pago de uma vez, ao valor de um mês de
          salário base. A pagamento único, esse valor líquido cai inteiro em junho e novembro. Em
          duodécimos, o mesmo valor total anual é distribuído por igual pelos 12 meses.
        </p>
      </details>
    </section>

    <div class="legal-body mt-14">
      <h2>O direito aos dois subsídios</h2>
      <p>
        Qualquer trabalhador por conta de outrem em Portugal tem direito, por lei, a um subsídio
        de férias e a um subsídio de Natal, cada um equivalente a um mês de retribuição base (mais
        eventuais outras prestações regulares e periódicas). O subsídio de férias é normalmente
        pago antes do gozo das férias, e o de Natal até 15 de dezembro. No primeiro ano de
        trabalho, o valor é proporcional ao tempo de serviço prestado nesse ano civil, não o mês
        completo.
      </p>

      <h2>Pagamento único vs. duodécimos</h2>
      <p>
        Por defeito, os subsídios são pagos de uma vez, nos seus meses próprios -- é por isso que
        junho e novembro costumam parecer meses "bons" e os outros dez, mais apertados em
        comparação. A opção de duodécimos, restabelecida pela Lei n.º 90/2019, permite ao
        trabalhador pedir que o valor de ambos os subsídios seja distribuído por igual pelos 12
        meses do ano, suavizando o rendimento mensal em vez de o concentrar em dois picos. O total
        recebido ao longo do ano é exatamente o mesmo nos dois casos -- muda apenas quando o
        dinheiro chega.
      </p>

      <h2>Como pedir duodécimos</h2>
      <p>
        A opção faz-se por comunicação escrita ao empregador, normalmente até 31 de outubro do ano
        anterior, para produzir efeito a partir de 1 de janeiro seguinte. Não é uma escolha que se
        ativa a meio do ano corrente -- se estás a pensar mudar, vale a pena confirmar o prazo e o
        processo exatos com o teu departamento de recursos humanos.
      </p>

      <h2>Como são retidos os subsídios</h2>
      <p>
        Ao contrário do salário mensal normal, cada subsídio é retido na fonte de forma autónoma:
        a taxa aplicada é a que corresponderia a receber esse valor completo de uma vez, mesmo que
        na prática (em duodécimos) só chegue uma fração dele a cada mês. Não há subsídio de
        alimentação associado ao pagamento do subsídio em si -- essa componente só se aplica ao
        salário mensal regular.
      </p>

      <h2>O que esta calculadora não faz</h2>
      <p>
        Assume que ambos os subsídios valem exatamente um mês de salário base, o padrão legal --
        se o teu contrato ou acordo coletivo prevê um valor diferente, os números aqui não vão
        corresponder exatamente ao teu recibo. Também não modela o primeiro ano de trabalho
        (subsídio proporcional) nem situações de suspensão do contrato.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Ferramentas relacionadas</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <a
          href="/ferramentas/salario-liquido"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="check-circle" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Salário Líquido</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            A mesma retenção na fonte, mas para o teu mês normal.
          </p>
        </a>
        <a
          href="/ferramentas/fundo-de-emergencia"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="shield-check" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Fundo de Emergência</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Um bom destino para parte do subsídio de férias, antes de o gastares nas férias.
          </p>
        </a>
      </div>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="calendar-blank" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        Já sabes o calendário. Agora falta tê-lo sempre à vista.
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        O Otterbond adiciona os teus subsídios ao calendário de pagamentos, para os veres chegar
        junto com o resto do teu rendimento.
      </p>
      <a
        id="bridge-cta"
        href="/pt-pt/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Experimentar grátis
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>

    <p class="mt-8 max-w-[60ch] text-xs leading-relaxed text-[var(--color-ink-faint)]">
      Estimativa a partir de regras públicas de retenção na fonte para 2026, não é aconselhamento
      fiscal, legal ou financeiro.
    </p>
  </main>

  <Footer lang="pt-pt" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd)} />
  <script is:inline define:vars={{ monthLabels }}>
    window.__monthLabels = monthLabels;
  </script>
</BaseLayout>

<script>
  import { calculateSalary, type FilingStatus, type Region, type SubsidyPaymentMode } from '../../lib/calculators/salaryCalculator';
  import { buildPaySchedule } from '../../lib/calculators/paySchedule';

  const TOOL_SLUG = 'subsidio-ferias-natal-duodecimos';
  const monthLabels: string[] = (window as unknown as { __monthLabels: string[] }).__monthLabels;

  function trackEvent(name: string) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, { tool: TOOL_SLUG });
    }
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('pt-PT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLSelectElement).value;
  }

  function recalc() {
    const paymentMode = val('paymentMode') as SubsidyPaymentMode;

    const salary = calculateSalary({
      direction: 'grossToNet',
      amount: num('amount'),
      region: val('region') as Region,
      filingStatus: val('filingStatus') as FilingStatus,
      dependents: num('dependents'),
      disabled: false,
    });

    const schedule = buildPaySchedule(salary, paymentMode);

    if (paymentMode === 'lumpSum') {
      document.getElementById('result-headline')!.textContent =
        `${euro.format(salary.regularMonth.net)}/mês, com ${euro.format(salary.regularMonth.net + salary.subsidyMonth.net)} em junho e novembro.`;
    } else {
      document.getElementById('result-headline')!.textContent =
        `${euro.format(salary.monthlyWithDuodecimos.net)} todos os meses, sem picos em junho ou novembro.`;
    }

    const grid = document.getElementById('calendar-grid')!;
    grid.innerHTML = '';
    schedule.forEach((entry) => {
      const cell = document.createElement('div');
      cell.className = `rounded-xl p-3 text-center ${entry.isSubsidy ? 'bg-[var(--color-mint-deep)] text-white' : 'bg-[var(--color-mint-deep)]/10 text-[var(--color-mint-deep)]'}`;
      cell.innerHTML = `<p class="text-xs font-medium opacity-70">${monthLabels[entry.month - 1]}</p><p class="mt-1 text-sm font-medium">${euro.format(entry.net)}</p>`;
      grid.appendChild(cell);
    });
  }

  let hasFiredCompleted = false;
  form.addEventListener('input', () => {
    if (!hasFiredCompleted) {
      hasFiredCompleted = true;
      trackEvent('tool_completed');
    }
    recalc();
  });

  recalc();
  trackEvent('tool_view');

  document.getElementById('bridge-cta')?.addEventListener('click', () => trackEvent('tool_bridge_click'));
</script>
