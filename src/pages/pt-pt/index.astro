---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Hero from '../../components/Hero.astro';
import PersonaWorlds from '../../components/PersonaWorlds.astro';
import FreeToolsStrip from '../../components/FreeToolsStrip.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Pricing from '../../components/Pricing.astro';
import Faq from '../../components/Faq.astro';
import Waitlist from '../../components/Waitlist.astro';
import Footer from '../../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Deliberately no aggregateRating/review here: there are none yet, and inventing one would be
// exactly the kind of fake trust signal this project's own design rules ban.
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Otterbond',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description: t('meta.description'),
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'Plus', price: '2.99', priceCurrency: 'EUR' },
  ],
};
---

<BaseLayout>
  <NavBar />
  <main>
    <PersonaWorlds id="features" limit={5} allHref={lang === 'en' ? '/who-its-for' : '/pt-pt/para-quem'} withHero>
      <Hero slot="hero" />
    </PersonaWorlds>
    <HowItWorks />
    <Pricing />
    <FreeToolsStrip />
    <Faq />
    <ClosingCta />
    <Waitlist />
  </main>
  <Footer />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareAppJsonLd)} />
</BaseLayout>
