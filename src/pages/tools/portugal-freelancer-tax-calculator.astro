---
// English counterpart of /ferramentas/recibos-verdes.astro -- see that file's own comment for the
// shared "front door, not a feature of the app" rationale. Deliberately NOT at a /pt-pt/-mirrored
// path (its Portuguese equivalent lives at the unrelated /ferramentas/recibos-verdes), so
// BaseLayout gets `noAlternate` too. "Recibos verdes" has no English name, so this page is framed
// by what it computes (freelance/self-employed tax in Portugal) for English-speaking expats
// searching in English, not a literal translation of the Portuguese term.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Portugal Freelancer Tax Calculator 2026: IRS, Social Security & net income';
const description =
  "Calculate your net income as a freelancer (recibos verdes) in Portugal for 2026: IRS withholding, Social Security, simplified regime, 1st-year exemption. Instant result, no sign-up.";
---

<BaseLayout title={title} description={description} lang="en" noAlternate>
  <NavBar lang="en" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Portugal Freelancer Tax Calculator 2026
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Enter your income and see an estimate of IRS withholding, Social Security, and net income as
      a self-employed worker (recibos verdes) in Portugal, using the 2026 rules (simplified regime,
      Category B).
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Income</span>
        <div class="mt-1.5 flex gap-2">
          <input
            type="number"
            id="income"
            value="2000"
            min="0"
            step="1"
            class="w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
          />
          <select
            id="incomeFrequency"
            class="rounded-xl border border-black/10 bg-white px-3 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
          >
            <option value="month" selected>per month</option>
            <option value="year">per year</option>
            <option value="day">per day</option>
          </select>
        </div>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Simplified regime</span>
        <select
          id="simplifiedRegimeYear"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="standard" selected>Standard year (75% coefficient)</option>
          <option value="firstYear">1st year of activity (37.5%)</option>
          <option value="secondYear">2nd year of activity (56.25%)</option>
        </select>
      </label>

      <label class="mt-1 flex items-center gap-2.5 text-sm sm:mt-6">
        <input
          type="checkbox"
          id="socialSecurityFirstYearExempt"
          class="h-4 w-4 rounded accent-[var(--color-mint-deep)]"
        />
        <span class="text-[var(--color-ink)]">Exempt from Social Security (1st year of activity)</span>
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Advanced options (dependents, marital status, NHR, Youth IRS...)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Days without activity (beyond the 248 working days)</span>
            <input
              type="number"
              id="daysOff"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Adjustment to the Social Security base</span>
            <select
              id="socialSecurityDiscount"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="-0.25">-25%</option>
              <option value="-0.2">-20%</option>
              <option value="-0.15">-15%</option>
              <option value="-0.1">-10%</option>
              <option value="-0.05">-5%</option>
              <option value="0" selected>No adjustment</option>
              <option value="0.05">+5%</option>
              <option value="0.1">+10%</option>
              <option value="0.15">+15%</option>
              <option value="0.2">+20%</option>
              <option value="0.25">+25%</option>
            </select>
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Documented real expenses (€/year)</span>
            <input
              type="number"
              id="expenses"
              placeholder="Leave blank to calculate automatically"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none placeholder:text-[var(--color-placeholder)] focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Marital status</span>
            <select
              id="maritalStatus"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="single" selected>Single / separate taxation</option>
              <option value="married">Married / de facto union (joint taxation)</option>
            </select>
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm" id="spouse-working-wrap" hidden>
            <input type="checkbox" id="spouseWorking" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">Spouse also works and has income</span>
          </label>

          <label class="block text-sm" id="spouse-income-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Spouse's annual taxable income (€)</span>
            <input
              type="number"
              id="spouseTaxableIncome"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Number of dependents</span>
            <input
              type="number"
              id="dependents"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">... of which age 6 or under</span>
            <input
              type="number"
              id="dependentsAgeSixOrUnder"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">... of which under 3 years old</span>
            <input
              type="number"
              id="dependentsUnderThree"
              value="0"
              min="0"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm">
            <input type="checkbox" id="nonHabitualResident" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">Non-Habitual Resident (NHR, flat 20% rate)</span>
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm">
            <input type="checkbox" id="youthIrsEnabled" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">Youth IRS</span>
          </label>

          <label class="block text-sm" id="youth-year-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Which benefit year?</span>
            <select
              id="youthIrsBenefitYear"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => <option value={n}>Year {n}</option>)}
            </select>
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-[var(--color-mint-deep)]/70">Estimated net income / month</p>
      <p class="mt-1 text-4xl font-medium text-[var(--color-mint-deep)]" id="result-net">€0</p>

      <div class="mt-5 grid grid-cols-2 gap-4 text-[15px] text-[var(--color-mint-deep)] sm:grid-cols-3">
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Gross income</p>
          <p class="font-medium" id="result-gross">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">IRS withheld</p>
          <p class="font-medium" id="result-irs">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Social Security</p>
          <p class="font-medium" id="result-ss">€0</p>
        </div>
      </div>

      <p class="mt-5 text-sm text-[var(--color-mint-deep)]/80" id="result-detail"></p>
    </section>

    <div class="legal-body mt-14">
      <h2>How net income is calculated for freelancers (recibos verdes)</h2>
      <p>
        Under the simplified regime (Category B), Portugal's tax authority doesn't tax your gross
        income directly. A coefficient is first applied to your annual gross income, 75% under the
        standard regime, to reach your taxable income, which is then subject to progressive IRS
        brackets. Social Security is calculated separately, on 70% of your relevant income over the
        last three months (capped at 12x the IAS per year).
      </p>
      <p>
        This calculator applies the official "average rate + marginal rate" simplified method: up
        to the previous bracket's limit, the accumulated average rate for that bracket applies, and
        only the excess is taxed at the marginal rate of the bracket your taxable income falls
        into. It's the same method used in the official withholding tables.
      </p>

      <h2>Simplified regime: reduced coefficients in the 1st and 2nd year</h2>
      <p>
        Anyone just starting out gets a reduced coefficient in their first two years of activity:
        37.5% in the first year and 56.25% in the second, instead of the usual 75%, which
        significantly lowers taxable income (and therefore IRS) during that period. From the third
        year onward, the standard 75% coefficient applies.
      </p>

      <h2>Social Security exemption in the first year</h2>
      <p>
        Anyone opening activity as a self-employed worker for the first time generally gets an
        exemption from Social Security contributions for the first 12 months of activity. After
        that period, contributions are calculated normally (21.4% of 70% of relevant income, with a
        monthly minimum). This calculator models that exemption as an option you can toggle.
      </p>

      <h2>VAT exemption (and why it isn't part of this calculation)</h2>
      <p>
        Anyone issuing recibos verdes who expects (or invoiced in the previous year) less than
        €15,000 generally falls automatically under the VAT exemption regime (article 53 of the VAT
        Code), meaning no VAT is charged on invoices or handed over to the state, but VAT on
        business expenses can't be deducted either. Above that threshold, or by choice, normal VAT
        charging applies. This calculator focuses only on IRS and Social Security, VAT doesn't
        affect your take-home net income the same way taxable IRS income does, so it isn't part of
        this calculation.
      </p>

      <h2>What this calculator doesn't replace</h2>
      <p>
        These figures are a careful estimate based on the official 2026 tables and formulas, but
        they don't account for every particularity of your situation (for example, specific
        deductions, dependent ascendants, or less common special regimes). For your actual IRS tax
        return, or for decisions that depend on an exact figure, talk to a certified accountant.
      </p>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="coins" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        Now you know your net income. Do you know how much you can spend per day until your next payment?
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        Otterbond does that math every morning, and automatically sets aside what you'll need for
        IRS and Social Security.
      </p>
      <a
        href="/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Try it free
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<script>
  import {
    calculateFreelancerTaxes,
    DEFAULT_TAX_YEAR,
    type IncomeFrequency,
    type SimplifiedRegimeYear,
    type MaritalStatus,
  } from '../../lib/calculators/taxCalculator';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const pct = new Intl.NumberFormat('en-IE', { style: 'percent', maximumFractionDigits: 1 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function checked(id: string): boolean {
    return (document.getElementById(id) as HTMLInputElement).checked;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value;
  }

  const maritalStatusSelect = document.getElementById('maritalStatus') as HTMLSelectElement;
  const spouseWorkingWrap = document.getElementById('spouse-working-wrap') as HTMLElement;
  const spouseIncomeWrap = document.getElementById('spouse-income-wrap') as HTMLElement;
  const youthEnabledInput = document.getElementById('youthIrsEnabled') as HTMLInputElement;
  const youthYearWrap = document.getElementById('youth-year-wrap') as HTMLElement;

  function syncVisibility() {
    const married = maritalStatusSelect.value === 'married';
    spouseWorkingWrap.hidden = !married;
    spouseIncomeWrap.hidden = !married || !checked('spouseWorking');
    youthYearWrap.hidden = !youthEnabledInput.checked;
  }

  function recalc() {
    syncVisibility();

    const result = calculateFreelancerTaxes({
      income: num('income'),
      incomeFrequency: val('incomeFrequency') as IncomeFrequency,
      taxYear: DEFAULT_TAX_YEAR,
      daysOff: num('daysOff'),
      socialSecurityDiscount: Number(val('socialSecurityDiscount')),
      socialSecurityFirstYearExempt: checked('socialSecurityFirstYearExempt'),
      simplifiedRegimeYear: val('simplifiedRegimeYear') as SimplifiedRegimeYear,
      expenses: val('expenses') === '' ? null : num('expenses'),
      nonHabitualResident: checked('nonHabitualResident'),
      youthIrs: youthEnabledInput.checked
        ? { enabled: true, benefitYear: num('youthIrsBenefitYear') || 1 }
        : null,
      maritalStatus: val('maritalStatus') as MaritalStatus,
      spouseWorking: checked('spouseWorking'),
      spouseTaxableIncome: num('spouseTaxableIncome'),
      dependents: num('dependents'),
      dependentsAgeSixOrUnder: num('dependentsAgeSixOrUnder'),
      dependentsUnderThree: num('dependentsUnderThree'),
    });

    document.getElementById('result-net')!.textContent = euro.format(result.netIncome.month);
    document.getElementById('result-gross')!.textContent = euro.format(result.grossIncome.month);
    document.getElementById('result-irs')!.textContent = euro.format(result.irs.month);
    document.getElementById('result-ss')!.textContent = euro.format(result.socialSecurity.month);

    const detail = document.getElementById('result-detail')!;
    if (result.bracket) {
      detail.textContent = `Taxable income: ${euro.format(result.taxableIncome)}/year · IRS bracket: ${pct.format(result.bracket.normalRate)}${result.jointTaxationApplied ? ' · joint taxation applied' : ''}`;
    } else {
      detail.textContent = '';
    }
  }

  form.addEventListener('input', recalc);
  recalc();
</script>
