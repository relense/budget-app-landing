---
// English counterpart of /ferramentas/index.astro -- see that file's own comment for the shared
// rationale. Standalone, English-only page (its PT equivalent lives at the unrelated
// /ferramentas), same `lang`/`noAlternate` reasoning as every other page in this directory.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Free Financial Tools: calculators for Portugal';
const description =
  'Free, no-signup calculators for Portugal: net salary, freelancer tax, state pension, compound interest, and financial independence (FIRE).';

const groups = [
  {
    heading: 'Budget and savings',
    tools: [
      {
        href: '/tools/compound-interest',
        icon: 'piggy-bank' as const,
        title: 'Compound Interest Calculator',
        body: 'See how a starting balance and a monthly amount grow over time.',
      },
      {
        // No English version yet (this one launched PT-only, per the product brief) -- link
        // straight to the PT page rather than a non-existent /tools/fire-calculator, same as the
        // other calculators did before they got English counterparts.
        href: '/ferramentas/calculadora-fire',
        icon: 'fire' as const,
        title: 'FIRE Calculator (PT)',
        body: "How much you need invested to live off it, and when you'll get there at your current pace.",
      },
      {
        href: '/tools/portugal-state-pension-calculator',
        icon: 'hourglass' as const,
        title: 'Portugal State Pension Calculator',
        body: 'Estimate your future state pension and how much you need to save to close the gap.',
      },
      {
        href: '/tools/emergency-fund-calculator',
        icon: 'shield-check' as const,
        title: 'Emergency Fund Calculator',
        body: 'How much you should have set aside, and how many months until you get there.',
      },
      {
        href: '/tools/50-30-20-rule-calculator',
        icon: 'chart-pie' as const,
        title: '50/30/20 Rule Calculator',
        body: 'The three buckets of your budget -- needs, wants, savings -- from your net salary.',
      },
      {
        href: '/tools/portugal-inflation-calculator',
        icon: 'trend-up' as const,
        title: 'Portugal Inflation Calculator',
        body: 'What an amount was worth (or will be worth) in another year, with the INE series.',
      },
      {
        href: '/tools/true-cost-of-a-car-calculator',
        icon: 'car-simple' as const,
        title: 'True Cost of a Car Calculator',
        body: 'Depreciation, insurance, fuel, IUC, maintenance and financing, in a single monthly number.',
      },
    ],
  },
  {
    heading: 'Home and credit',
    tools: [
      {
        href: '/tools/portugal-mortgage-prepayment-calculator',
        icon: 'house-line' as const,
        title: 'Portugal Mortgage Prepayment Calculator',
        body: 'How much you save in interest, and how much sooner you finish, by prepaying early.',
      },
      {
        href: '/tools/portugal-property-transfer-tax-calculator',
        icon: 'stamp' as const,
        title: 'Portugal Property Transfer Tax Calculator (IMT & Stamp Duty)',
        body: "What you'll pay at the deed signing, with 2026's tables and the IMT Jovem exemption.",
      },
    ],
  },
  {
    heading: 'Couples and shared budgeting',
    tools: [
      {
        href: '/tools/split-expenses-couple-calculator',
        icon: 'heart' as const,
        title: 'How to Split Expenses as a Couple',
        body: 'Compare three ways to split rent and bills: 50/50, proportional, or equal leftover.',
      },
    ],
  },
  {
    heading: 'Salary and taxes',
    tools: [
      {
        href: '/tools/portugal-net-salary-calculator',
        icon: 'check-circle' as const,
        title: 'Portugal Net Salary Calculator',
        body: "Go from gross to net (or the other way around) with 2026's official tables.",
      },
      {
        href: '/tools/portugal-freelancer-tax-calculator',
        icon: 'coins' as const,
        title: 'Portugal Freelancer Tax Calculator',
        body: 'Estimate your net income as a freelancer, IRS and Social Security included.',
      },
      {
        href: '/tools/portugal-vat-calculator',
        icon: 'percent' as const,
        title: 'Portugal VAT Calculator (IVA)',
        body: "Add or extract VAT from an amount, with 2026's rates for all three regions.",
      },
      {
        href: '/tools/portugal-income-tax-calculator',
        icon: 'receipt' as const,
        title: 'Portugal Income Tax Calculator (IRS)',
        body: "Estimate whether you'll get a refund or owe IRS, with 2026's brackets and limits.",
      },
      {
        href: '/tools/portugal-unemployment-benefit-calculator',
        icon: 'umbrella' as const,
        title: 'Portugal Unemployment Benefit Calculator',
        body: 'Estimate the monthly amount and duration of the benefit, with 2026 limits and table.',
      },
      {
        href: '/tools/portugal-overtime-pay-calculator',
        icon: 'moon-stars' as const,
        title: 'Portugal Overtime & Night Work Pay Calculator',
        body: "What your overtime and night hours are worth, with the Código do Trabalho's supplements.",
      },
      {
        href: '/tools/portugal-sick-leave-pay-calculator',
        icon: 'first-aid' as const,
        title: 'Portugal Sick Leave Pay Calculator',
        body: "How much you'll receive per day and in total, with 2026's waiting period.",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} lang="en" noAlternate>
  <NavBar lang="en" />

  <main class="mx-auto max-w-5xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Free Financial Tools
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Free, no-signup calculators and simulators for anyone living and working in Portugal. The
      same numbers Otterbond uses internally.
    </p>

    {
      groups.map((group) => (
        <section class="mt-12">
          <h2 class="text-xl font-medium text-[var(--color-ink)]">{group.heading}</h2>
          <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
            {group.tools.map((tool) => (
              <a href={tool.href} class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6">
                <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
                  <Icon name={tool.icon} class="h-5 w-5" />
                </div>
                <h3 class="mt-4 text-lg font-medium text-[var(--color-ink)]">{tool.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{tool.body}</p>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </main>

  <Footer lang="en" />
</BaseLayout>
