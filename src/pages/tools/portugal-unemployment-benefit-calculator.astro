---
// English counterpart of /ferramentas/simulador-subsidio-desemprego.astro -- see recibos-verdes.astro's
// own comment for the shared "front door, not a feature of the app" rationale and the
// `lang`/`noAlternate` reasoning. See unemploymentBenefit.ts's own comment for the full sourcing,
// including the "-10% after 180 days" correction (repealed in 2018, not modeled).
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Portugal Unemployment Benefit Calculator 2026';
const description =
  "Estimate the monthly amount and duration of Portugal's unemployment benefit, with 2026's limits and duration table. Instant result, no sign-up.";

const faqs = [
  {
    question: 'Who is entitled to unemployment benefit?',
    answer:
      "Anyone made involuntarily unemployed (dismissal, a fixed-term contract not renewed, among other situations) who has at least 360 days of registered earnings in the previous 24 months -- the so-called qualifying period. Someone who resigns voluntarily generally isn't entitled, except in specific exceptions.",
  },
  {
    question: 'Does the amount drop after a few months?',
    answer:
      "Not since 2018 -- the old rule that reduced the amount by 10% after 180 days was repealed by Lei n.º 114/2017 (the 2018 state budget). The amount stays constant for the whole period it's granted, only changing if the IAS is updated. There's still a lot of outdated information online quoting that reduction -- it doesn't apply.",
  },
  {
    question: 'How do I apply for unemployment benefit?',
    answer:
      "The application is made through Segurança Social Direta, ideally within 90 days of becoming unemployed (a delay can reduce the benefit's duration). You need to be registered as unemployed with the IEFP and submit the required documentation, including the reason your contract ended.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
};
---

<BaseLayout title={title} description={description} lang="en" noAlternate>
  <NavBar lang="en" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Portugal Unemployment Benefit Calculator
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Enter your average salary, age, and contribution history, and see an estimate of how much
      you could receive per month, and for how many days.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Average gross salary, last 12 months (€)</span>
        <input
          type="number"
          id="averageMonthlySalary"
          value="1500"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Age band</span>
        <select
          id="ageBand"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="under30">Under 30</option>
          <option value="30to39" selected>30 to 39</option>
          <option value="40to49">40 to 49</option>
          <option value="50plus">50 or over</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Months contributed since your last unemployment</span>
        <input
          type="number"
          id="contributionMonths"
          value="30"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Contribution-months band</span>
        <select
          id="contributionBand"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="under15">Under 15 months</option>
          <option value="15to24">15 to 24 months</option>
          <option value="atLeast24" selected>24 months or more</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Years contributed in the last 20 years</span>
        <input
          type="number"
          id="yearsRegisteredLast20"
          value="0"
          min="0"
          max="20"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
        <p class="mt-1.5 text-xs text-[var(--color-ink-faint)]">Every 5 years here adds days to the benefit period.</p>
      </label>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-lg leading-snug font-medium text-[var(--color-mint-deep)]" id="result-headline"></p>
      <p class="mt-4 text-[15px] text-[var(--color-mint-deep)]/80" id="result-detail"></p>

      <details class="mt-5">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-mint-deep)]/70">
          How we calculated this
        </summary>
        <p class="mt-2 max-w-[58ch] text-sm leading-relaxed text-[var(--color-mint-deep)]/80">
          Monthly amount = 65% of your average reference salary, with a minimum of 1 IAS (or 1.15
          IAS if your salary is at or above the minimum wage) and a maximum of 2.5 IAS, 2026
          figures. Duration comes from the official table by age and contribution months, with
          extra days for every 5 full years contributed in the last 20 years.
        </p>
      </details>
    </section>

    <div class="legal-body mt-14">
      <h2>How the amount is calculated</h2>
      <p>
        The benefit corresponds to 65% of your reference remuneration -- the average of your
        salaries registered with Social Security over the first 12 of the last 14 months before
        becoming unemployed, including holiday and Christmas subsidies. That figure is always
        subject to a minimum and a maximum, indexed to the IAS (Indexante dos Apoios Sociais): in
        2026, the minimum is 1 IAS (€537.13), or 1.15 IAS (€617.70) if you earned at least the
        minimum wage, and the maximum is 2.5 IAS (€1,342.83).
      </p>

      <h2>A correction to a common mistake</h2>
      <p>
        You'll find a lot of information online (including articles "updated for 2026") claiming
        the benefit drops 10% after 180 days. That rule did exist, but it was repealed in 2018 by
        Lei n.º 114/2017 -- since then, the amount stays constant for the entire period granted,
        only changing if the IAS is updated in the meantime.
      </p>

      <h2>How duration works</h2>
      <p>
        Duration depends on two factors: your age at the date of unemployment, and how long you've
        been contributing since the last time you were unemployed. The older you are and the
        longer your contribution history, the longer the period -- ranging from 150 days (under 30,
        short contribution history) up to 540 days or more (50 or over, long career). For every 5
        full years contributed and registered in the last 20 years, a bonus of extra days is added,
        which also increases with age.
      </p>

      <h2>The qualifying period</h2>
      <p>
        To be entitled to the benefit, you need 360 days of registered earnings in the 24 months
        before becoming unemployed -- roughly 12 months of continuous or intermittent work. Without
        that period met, there's no entitlement to the standard benefit (you may still be entitled
        to other support, like the social unemployment subsidy, not modelled here).
      </p>

      <h2>What this calculator doesn't do</h2>
      <p>
        It doesn't model the additional cap of 75% of net reference remuneration (rarely the
        binding limit, but it exists), nor special situations like partial unemployment,
        self-employed workers, or the social unemployment subsidy for those who don't meet the
        standard qualifying period.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Related tools</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <a
          href="/tools/emergency-fund-calculator"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="shield-check" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">Emergency Fund</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            See how much of a cushion you need to cover the gap until the benefit arrives.
          </p>
        </a>
        <a
          href="/tools/50-30-20-rule-calculator"
          class="block rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6"
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
            <Icon name="chart-pie" class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-[15px] font-medium text-[var(--color-ink)]">50/30/20 Rule</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]">
            Plan how to adjust your budget to a temporarily lower income.
          </p>
        </a>
      </div>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="umbrella" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        You know the number. Now see how your month looks.
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        Otterbond shows you how much you can spend per day with this income, no surprises
        halfway through the month.
      </p>
      <a
        id="bridge-cta"
        href="/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Try it free
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>

    <p class="mt-8 max-w-[60ch] text-xs leading-relaxed text-[var(--color-ink-faint)]">
      Estimate based on 2026 public rules, not financial, legal or tax advice, and not a substitute
      for Social Security's official calculation.
    </p>
  </main>

  <Footer lang="en" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApplicationJsonLd)} />
</BaseLayout>

<script>
  import {
    calculateUnemploymentBenefit,
    type AgeBand,
    type ContributionBand,
  } from '../../lib/calculators/unemploymentBenefit';

  const TOOL_SLUG = 'portugal-unemployment-benefit-calculator';

  function trackEvent(name: string) {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, { tool: TOOL_SLUG });
    }
  }

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLSelectElement).value;
  }

  function recalc() {
    const result = calculateUnemploymentBenefit({
      averageMonthlySalary: num('averageMonthlySalary'),
      ageBand: val('ageBand') as AgeBand,
      contributionMonths: num('contributionMonths'),
      contributionBand: val('contributionBand') as ContributionBand,
      yearsRegisteredLast20: num('yearsRegisteredLast20'),
    });

    const headline = document.getElementById('result-headline')!;
    const detail = document.getElementById('result-detail')!;

    if (!result.eligible) {
      headline.textContent = "You don't meet the qualifying period (360 days in the last 24 months).";
      detail.textContent = 'You may still be entitled to other support -- check on Segurança Social Direta.';
      return;
    }

    const months = Math.round((result.durationDays / 30) * 10) / 10;
    headline.textContent = `Around ${euro.format(result.monthlyBenefit)} per month, for ${result.durationDays} days (${months} months).`;
    detail.textContent = `Estimated total over the period: ${euro.format(result.totalOverDuration)}.`;
  }

  let hasFiredCompleted = false;
  form.addEventListener('input', () => {
    if (!hasFiredCompleted) {
      hasFiredCompleted = true;
      trackEvent('tool_completed');
    }
    recalc();
  });

  recalc();
  trackEvent('tool_view');

  document.getElementById('bridge-cta')?.addEventListener('click', () => trackEvent('tool_bridge_click'));
</script>
