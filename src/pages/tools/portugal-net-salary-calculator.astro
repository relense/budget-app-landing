---
// English counterpart of /ferramentas/salario-liquido.astro -- see that file's own comment for
// the shared "front door, not a feature of the app" rationale. Deliberately NOT at a
// /pt-pt/-mirrored path (its Portuguese equivalent lives at the unrelated
// /ferramentas/salario-liquido), so BaseLayout gets `noAlternate` too. Framed explicitly as a
// *Portugal* calculator (title, URL, copy) since the underlying math (IRS, Segurança Social) only
// applies there -- this targets English-speaking expats/foreigners searching in English, not a
// generic "net salary calculator" audience.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'Portugal Net Salary Calculator 2026: IRS, Social Security & subsidies';
const description =
  'Calculate your net salary in Portugal for 2026: IRS withholding, Social Security, meal allowance, holiday/Christmas subsidies. Mainland, Azores & Madeira. Instant result, no sign-up.';
---

<BaseLayout title={title} description={description} lang="en" noAlternate>
  <NavBar lang="en" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      Portugal Net Salary Calculator 2026
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      Calculate your net salary from your gross pay, or the gross you'd need for a target net, using
      the 2026 Portuguese withholding tables for Mainland, Azores and Madeira.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Calculate from</span>
        <select
          id="direction"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="grossToNet" selected>Gross salary → net</option>
          <option value="netToGross">Target net → gross needed</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]" id="amount-label">Monthly base salary (€)</span>
        <input
          type="number"
          id="amount"
          value="1500"
          min="0"
          step="1"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Region</span>
        <select
          id="region"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="continente" selected>Mainland</option>
          <option value="acores">Azores</option>
          <option value="madeira">Madeira</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Filing status</span>
        <select
          id="filingStatus"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        >
          <option value="single" selected>Single / married, two earners</option>
          <option value="marriedOneEarner">Married, single earner</option>
        </select>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Number of dependents</span>
        <input
          type="number"
          id="dependents"
          value="0"
          min="0"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Advanced options (meal allowance, disability)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="mt-1 flex items-center gap-2.5 text-sm sm:col-span-2">
            <input type="checkbox" id="mealAllowanceEnabled" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">I receive a meal allowance</span>
          </label>

          <label class="block text-sm" id="meal-amount-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Daily amount (€)</span>
            <input
              type="number"
              id="mealAllowanceDaily"
              value="7.63"
              min="0"
              step="0.01"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm" id="meal-type-wrap" hidden>
            <span class="font-medium text-[var(--color-ink)]">Payment method</span>
            <select
              id="mealAllowanceType"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            >
              <option value="card" selected>Meal card</option>
              <option value="cash">Cash / bank transfer</option>
            </select>
          </label>

          <label class="mt-1 flex items-center gap-2.5 text-sm sm:col-span-2">
            <input type="checkbox" id="disabled" class="h-4 w-4 rounded accent-[var(--color-mint-deep)]" />
            <span class="text-[var(--color-ink)]">Worker with disability (degree ≥ 60%)</span>
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-sm font-medium text-[var(--color-mint-deep)]/70" id="result-label">
        Estimated net salary / month
      </p>
      <p class="mt-1 text-4xl font-medium text-[var(--color-mint-deep)]" id="result-net">€0</p>

      <div class="mt-5 grid grid-cols-2 gap-4 text-[15px] text-[var(--color-mint-deep)] sm:grid-cols-3">
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Base salary</p>
          <p class="font-medium" id="result-gross">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">IRS withheld</p>
          <p class="font-medium" id="result-irs">€0</p>
        </div>
        <div>
          <p class="text-[var(--color-mint-deep)]/70">Social Security (11%)</p>
          <p class="font-medium" id="result-ss">€0</p>
        </div>
      </div>

      <p class="mt-5 text-sm text-[var(--color-mint-deep)]/80" id="result-detail"></p>
    </section>

    <div class="legal-body mt-14">
      <h2>How withholding tax works in Portugal</h2>
      <p>
        The amount you receive every month already has IRS (income tax) withheld at source,
        following official tables published each year (separate orders for Mainland, Azores and
        Madeira, each region with its own table). That withholding is an estimate of your annual
        tax, not the final amount, the definitive figure is only settled with the following year's
        IRS tax return, which can result in a refund or additional tax owed. Social Security, on
        the other hand, is always a flat 11% of the amount subject to it, with no brackets.
      </p>
      <p>
        The applicable table depends on your situation (single, married with two earners, or
        married with a single earner working) and your number of dependents, each combination has
        its own table with different rates and deductions.
      </p>

      <h2>Mainland, Azores and Madeira: why the amount changes</h2>
      <p>
        The autonomous regions have their own withholding tables, with lower rates than the
        Mainland. In the Azores, the reduction is a fixed percentage (around 30%) applied to all
        Mainland marginal rates. In Madeira the reduction doesn't follow a single formula, it's set
        table by table in the regional order, and for 2026 it was extended to more brackets than in
        previous years.
      </p>

      <h2>Meal allowance: what's exempt and what isn't</h2>
      <p>
        The meal allowance has a daily ceiling exempt from IRS and Social Security: higher if paid
        via a meal card than in cash. The portion of the allowance above that ceiling is treated as
        regular pay, it enters that month's IRS and Social Security calculation just like the base
        salary does.
      </p>

      <h2>Holiday and Christmas subsidies: lump sum or spread out</h2>
      <p>
        By law, you're entitled to a holiday subsidy and a Christmas subsidy, each normally equal
        to one month's base salary. They can be paid in full (in the month they're due) or spread
        across the year in twelfths, 1/12 of each subsidy added to every month's pay. The total
        over the year is the same either way, only the timing changes. Each subsidy paid as a lump
        sum is withheld at the rate that would apply to that amount received all at once, so it can
        look "heavier" in that specific month.
      </p>

      <h2>What this calculator doesn't replace</h2>
      <p>
        These figures are a careful estimate based on the official 2026 withholding tables, but
        your actual payslip may include other elements this simulator doesn't model (allowances
        specific to your contract, deductions for dependents with disabilities, among others). For
        questions about your specific payslip, talk to your employer's HR department.
      </p>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="check-circle" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        Now you know your net pay. Do you know how much of it you can spend today?
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        Otterbond tells you how much of that you can spend today, after bills and savings are
        already accounted for.
      </p>
      <a
        href="/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Try it free
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<script>
  import {
    calculateSalary,
    type CalculationDirection,
    type Region,
    type FilingStatus,
    type MealAllowanceType,
  } from '../../lib/calculators/salaryCalculator';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function checked(id: string): boolean {
    return (document.getElementById(id) as HTMLInputElement).checked;
  }
  function val(id: string): string {
    return (document.getElementById(id) as HTMLInputElement | HTMLSelectElement).value;
  }

  const directionSelect = document.getElementById('direction') as HTMLSelectElement;
  const amountLabel = document.getElementById('amount-label') as HTMLElement;
  const resultLabel = document.getElementById('result-label') as HTMLElement;
  const mealEnabled = document.getElementById('mealAllowanceEnabled') as HTMLInputElement;
  const mealAmountWrap = document.getElementById('meal-amount-wrap') as HTMLElement;
  const mealTypeWrap = document.getElementById('meal-type-wrap') as HTMLElement;

  function syncVisibility() {
    const netToGross = directionSelect.value === 'netToGross';
    amountLabel.textContent = netToGross
      ? 'Target monthly net (€)'
      : 'Monthly base salary (€)';
    resultLabel.textContent = netToGross
      ? 'Gross salary needed / month'
      : 'Estimated net salary / month';
    mealAmountWrap.hidden = !mealEnabled.checked;
    mealTypeWrap.hidden = !mealEnabled.checked;
  }

  function recalc() {
    syncVisibility();
    const netToGross = directionSelect.value === 'netToGross';

    const result = calculateSalary({
      direction: val('direction') as CalculationDirection,
      amount: num('amount'),
      region: val('region') as Region,
      filingStatus: val('filingStatus') as FilingStatus,
      dependents: num('dependents'),
      disabled: checked('disabled'),
      mealAllowance: mealEnabled.checked
        ? {
            dailyAmount: num('mealAllowanceDaily'),
            type: val('mealAllowanceType') as MealAllowanceType,
          }
        : null,
    });

    const month = result.regularMonth;
    document.getElementById('result-net')!.textContent = euro.format(
      netToGross ? result.baseSalary : month.net,
    );
    document.getElementById('result-gross')!.textContent = euro.format(result.baseSalary);
    document.getElementById('result-irs')!.textContent = euro.format(month.irs);
    document.getElementById('result-ss')!.textContent = euro.format(month.employeeSocialSecurity);

    const detail = document.getElementById('result-detail')!;
    detail.textContent = `Monthly net (including meal allowance, if applicable): ${euro.format(month.net)} · Holiday/Christmas subsidy (lump sum): ${euro.format(result.subsidyMonth.net)} each · Annual net (14 payments): ${euro.format(result.annual.net)}`;
  }

  form.addEventListener('input', recalc);
  recalc();
</script>
