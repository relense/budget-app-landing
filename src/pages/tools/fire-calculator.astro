---
// English counterpart of /ferramentas/calculadora-fire.astro -- see recibos-verdes.astro's own
// comment for the shared "front door, not a feature of the app" rationale and the
// `lang`/`noAlternate` reasoning. Last of the 14 English mirrors -- FIRE isn't part of the
// original 13-tool brief (it's the peer session's own tool), built PT-first per the product brief
// at the time; this fills that gap now that "all" tools are getting an EN version.
//
// Chart mechanics (inline SVG, colors, hover/tooltip) are copied verbatim from the PT page's own
// script -- see that file's own comment for the color-validation rationale. Only text content
// (labels, headline copy, FAQ, explainer) is translated.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

const title = 'FIRE Calculator: how much you need for financial independence';
const description =
  "Calculate how much you need invested to live off your portfolio, when you'll get there at your current pace, and what changes with a lower return. No sign-up.";

const faqs = [
  {
    question: 'Is 4% safe in Portugal?',
    answer:
      "The 4% rule comes from the Trinity Study (1998, US), based only on the historical record of US markets. More recent research (notably Wade Pfau's, covering 20 developed markets between 1900 and 2010) shows that outside the US, the historically safe rate is closer to 2.8%-3.5%, because European markets had lower real returns over the 20th century (two world wars, periods of hyperinflation, exchanges closed or destroyed). That's why many people in Europe use 3% to 3.5% instead of 4%, especially with a globally diversified portfolio (not just European stocks).",
  },
  {
    question: 'Does this account for the state pension?',
    answer:
      "No. This calculator assumes you need to generate your desired income entirely from your own portfolio, without counting on any future state pension. If you want to understand how much of your retirement the state pension should cover, and adjust your numbers accordingly, use our State Pension Calculator.",
    link: { label: 'Portugal State Pension Calculator', hash: '/tools/portugal-state-pension-calculator' },
  },
  {
    question: 'What about capital gains tax?',
    answer:
      "Also not included. When you sell holdings at a gain, that gain is normally subject to tax (in Portugal, capital gains on stocks/ETFs are taxed at a flat 28% rate, with specific rules depending on holding period and product type). The FIRE number here is gross of that effect -- the net amount you can actually withdraw may be somewhat lower depending on your tax situation.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout title={title} description={description} lang="en" noAlternate>
  <NavBar lang="en" />

  <main class="mx-auto max-w-3xl px-5 pt-12 pb-24 sm:px-8 sm:pt-16">
    <h1 class="text-3xl leading-tight font-medium text-[var(--color-ink)] sm:text-4xl">
      FIRE Calculator
    </h1>
    <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
      How much you need invested to live off your portfolio, when you'll get there at your
      current pace, and what changes with a lower return.
    </p>
    <p class="mt-4 max-w-[60ch] rounded-xl bg-[var(--color-bg-elevated)] px-4 py-3 text-sm leading-relaxed text-[var(--color-ink-soft)]">
      This is a projection from assumptions you can edit, not a personal forecast or financial
      advice. No index, broker or product names.
    </p>

    <form
      id="calc-form"
      class="mt-8 grid grid-cols-1 gap-4 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:grid-cols-2 sm:p-8"
    >
      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Desired monthly income in retirement (€)</span>
        <input
          type="number"
          id="desiredMonthlyIncome"
          value="1500"
          min="0"
          step="10"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Already invested (€)</span>
        <input
          type="number"
          id="currentAmount"
          value="20000"
          min="0"
          step="100"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
      </label>

      <label class="block text-sm sm:col-span-2">
        <span class="font-medium text-[var(--color-ink)]">Monthly contribution (€)</span>
        <input
          type="number"
          id="monthlyContribution"
          value="500"
          min="0"
          step="10"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
        />
        <div class="mt-3 flex items-center gap-3">
          <span class="text-xs whitespace-nowrap text-[var(--color-ink-faint)]">What if you saved...</span>
          <input
            type="range"
            id="monthlyContributionSlider"
            min="0"
            max="3000"
            step="10"
            value="500"
            class="w-full accent-[var(--color-mint-deep)]"
          />
        </div>
      </label>

      <label class="block text-sm">
        <span class="font-medium text-[var(--color-ink)]">Current age (optional)</span>
        <input
          type="number"
          id="currentAge"
          min="16"
          max="90"
          step="1"
          placeholder="To see your age at FIRE"
          class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none placeholder:text-[var(--color-placeholder)] focus:ring-2 focus:ring-[var(--color-mint)]"
        />
        <p class="mt-1 text-xs text-[var(--color-ink-faint)]">Also makes Coast FIRE more accurate.</p>
      </label>

      <details class="sm:col-span-2">
        <summary class="cursor-pointer text-sm font-medium text-[var(--color-ink-soft)]">
          Assumptions (return, inflation, withdrawal rate)
        </summary>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Expected annual nominal return (%)</span>
            <input
              type="number"
              id="nominalReturnPercent"
              value="7"
              min="0"
              step="0.1"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm">
            <span class="font-medium text-[var(--color-ink)]">Expected annual inflation (%)</span>
            <input
              type="number"
              id="inflationPercent"
              value="2"
              min="0"
              step="0.1"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
          </label>

          <label class="block text-sm sm:col-span-2">
            <span class="font-medium text-[var(--color-ink)]">Safe withdrawal rate (%)</span>
            <input
              type="number"
              id="withdrawalRatePercent"
              value="4"
              min="1"
              step="0.1"
              class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-3.5 py-2.5 text-[15px] text-[var(--color-on-surface)] outline-none focus:ring-2 focus:ring-[var(--color-mint)]"
            />
            <p class="mt-1 text-xs text-[var(--color-ink-faint)]">
              The "4% rule" comes from the Trinity Study (1998, US); outside the US, many people
              use 3% to 3.5% for safety (see explanation below).
            </p>
          </label>
        </div>
      </details>
    </form>

    <section
      id="results"
      class="mt-6 rounded-[var(--radius-card)] bg-[var(--color-mint)] p-6 sm:p-8"
      aria-live="polite"
    >
      <p class="text-lg leading-snug font-medium text-[var(--color-mint-deep)]" id="result-headline"></p>

      <div class="mt-4 grid grid-cols-1 gap-3 text-[15px] text-[var(--color-mint-deep)] sm:grid-cols-2">
        <p id="result-primary-pace"></p>
        <p id="result-lower-pace"></p>
      </div>

      <p class="mt-4 text-[15px] text-[var(--color-mint-deep)]/80" id="result-coast"></p>
    </section>

    <div class="mt-8 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-5 text-sm text-[var(--color-ink-soft)]">
        <span class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full" style="background:#3987e5"></span>
          At current pace
        </span>
        <span class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full" style="background:#d95926"></span>
          <span id="legend-lower-return"></span>
        </span>
        <span class="flex items-center gap-2">
          <span class="h-0.5 w-3.5" style="background:var(--color-ink-faint)"></span>
          FIRE target
        </span>
      </div>
      <svg id="fire-chart" viewBox="0 0 640 300" class="mt-4 w-full touch-none select-none" role="img" aria-label="Portfolio projection over time">
        <g id="chart-gridlines"></g>
        <line id="chart-fire-line" x1="0" y1="0" x2="0" y2="0" stroke="var(--color-ink-faint)" stroke-width="1.5" stroke-dasharray="4 4" />
        <polyline id="chart-line-primary" fill="none" stroke="#3987e5" stroke-width="2" />
        <polyline id="chart-line-lower" fill="none" stroke="#d95926" stroke-width="2" />
        <line id="chart-crosshair" x1="0" y1="0" x2="0" y2="0" stroke="var(--color-ink-faint)" stroke-width="1" opacity="0" />
        <g id="chart-tooltip" opacity="0">
          <rect width="150" height="58" rx="8" fill="var(--color-bg)" stroke="var(--color-line)" />
          <text id="tooltip-year" x="10" y="20" font-size="11" fill="var(--color-ink)"></text>
          <text id="tooltip-primary" x="10" y="36" font-size="11" fill="#3987e5"></text>
          <text id="tooltip-lower" x="10" y="50" font-size="11" fill="#d95926"></text>
        </g>
        <rect id="chart-hover-area" x="0" y="0" width="640" height="260" fill="transparent" />
      </svg>
    </div>

    <div class="legal-body mt-14">
      <h2>What FIRE is, and its variants</h2>
      <p>
        FIRE stands for "Financial Independence, Retire Early": building up enough capital that the
        returns on that capital cover your expenses, without depending on a salary. It isn't a
        single goal -- there are variants depending on lifestyle and the path to get there:
      </p>
      <p>
        <strong>Lean FIRE</strong>: living on a reduced budget with a lower target number, often
        with a minimalist lifestyle or moving somewhere with a lower cost of living.
      </p>
      <p>
        <strong>Coast FIRE</strong>: you already have enough invested that, through compound growth
        alone (with no further contributions), your capital reaches your FIRE number by around the
        normal retirement age. You keep working to cover current expenses, but no longer need to
        save more for the future.
      </p>
      <p>
        <strong>Barista FIRE</strong>: a middle ground -- you have enough invested to cover most of
        your expenses, but keep working part-time to cover the rest (and, in some countries, to
        keep benefits like health insurance).
      </p>

      <h2>Where the 4% rule comes from, and why many people use 3.5%</h2>
      <p>
        The "4% rule" originates from William Bengen's work (1994) and became popular through the
        Trinity Study (1998), an academic study that tested withdrawal rates against the historical
        US market. The conclusion: withdrawing 4% of the initial capital per year (adjusted for
        inflation afterward) survives the vast majority of historical 30-year periods in the US.
      </p>
      <p>
        The problem is that study uses only US data, which had one of the best stock market
        records of the 20th century. Research looking at other developed countries (notably Wade
        Pfau's, covering 20 markets between 1900 and 2010) shows that outside the US, a
        historically safe rate is closer to 2.8% to 3.5%, because European markets suffered more
        from wars, hyperinflation and exchange closures over the 20th century. That's why many
        people in Europe use 3% to 3.5% as a safety margin instead of the classic 4%, especially if
        the portfolio isn't broadly globally diversified.
      </p>

      <h2>Why this calculator works in real terms</h2>
      <p>
        Every figure here -- the desired income, the FIRE number, the capital accumulated over time
        -- is in today's euros, not future nominal euros. The nominal return you enter is converted
        internally into a real return (above inflation), so you don't have to think separately
        about inflation's effect on each figure.
      </p>

      <h2>Sequence-of-returns risk</h2>
      <p>
        Average returns over several years don't tell the whole story: the order in which returns
        happen matters, especially in the first few years after you stop working. If markets drop
        right at the start of your early retirement and you keep withdrawing the same amount,
        you're selling more units at lower prices, which can deplete capital much faster than the
        historical average suggests, even if the average return over the whole period ends up
        being good. That's why the safe withdrawal rate tends to be more conservative than a
        simple average of expected returns.
      </p>

      <h2>What this calculator ignores</h2>
      <p>
        It doesn't model capital gains tax (which reduces the net amount you can actually
        withdraw), management or transaction fees, or the real evolution of your salary or
        contributions over your career. It assumes a constant return every year, which real
        markets never offer. It's a tool for understanding the order of magnitude and the
        mechanism, not an exact forecast of your path.
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-medium text-[var(--color-ink)]">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium text-[var(--color-ink)] marker:content-none">
                {faq.question}
                <Icon
                  name="caret-down"
                  class="h-4 w-4 flex-shrink-0 text-[var(--color-ink-soft)] transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
                {faq.answer}
              </p>
              {'link' in faq && faq.link && (
                <a
                  href={faq.link.hash}
                  class="mt-2 inline-flex items-center gap-1 text-[15px] font-medium text-[var(--color-mint)] hover:underline"
                >
                  {faq.link.label}
                  <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              )}
            </details>
          ))
        }
      </div>
    </div>

    <div class="mt-14">
      <h2 class="text-lg font-medium text-[var(--color-ink)]">Related tools</h2>
      <ul class="mt-3 space-y-2 text-[15px] text-[var(--color-mint)]">
        <li>
          <a href="/tools/portugal-state-pension-calculator" class="inline-flex items-center gap-1 hover:underline">
            Portugal State Pension Calculator <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
        </li>
        <li>
          <a href="/tools/portugal-net-salary-calculator" class="inline-flex items-center gap-1 hover:underline">
            Portugal Net Salary Calculator <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
        </li>
      </ul>
    </div>

    <section class="mt-14 rounded-[var(--radius-card)] bg-[var(--color-bg-elevated)] p-7 sm:p-8">
      <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[var(--color-mint)] text-[var(--color-mint-deep)]">
        <Icon name="fire" class="h-5 w-5" />
      </div>
      <h2 class="mt-5 text-xl font-medium text-[var(--color-ink)]">
        You know the number. Now it's about staying on pace.
      </h2>
      <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-[var(--color-ink-soft)]">
        Otterbond helps you save that amount every month, and see whether your actual deposits
        keep up with the plan.
      </p>
      <a
        id="bridge-cta"
        href="/#get-the-app"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-[var(--color-pill)] px-7 py-3.5 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Try it free
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </section>
  </main>

  <Footer lang="en" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<script>
  import { calculateFire, projectPortfolioByYear } from '../../lib/calculators/fireCalculator';

  const form = document.getElementById('calc-form') as HTMLFormElement;
  const euro = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const contributionInput = document.getElementById('monthlyContribution') as HTMLInputElement;
  const contributionSlider = document.getElementById('monthlyContributionSlider') as HTMLInputElement;

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement;
    return Number(el.value) || 0;
  }
  function numOrNull(id: string): number | null {
    const el = document.getElementById(id) as HTMLInputElement;
    return el.value === '' ? null : Number(el.value);
  }

  function formatYears(years: number | null): string {
    if (years === null) return 'never, at this pace';
    if (years <= 0) return "you've already got there";
    return `${years.toFixed(1)} years`;
  }

  // gtag may not exist yet (cookie consent not accepted) -- guard every call.
  function track(event: string) {
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', event, { tool: 'fire-calculator' });
    }
  }

  let hasTrackedView = false;
  let hasTrackedCompletion = false;

  function recalc() {
    contributionInput.value = contributionSlider.value;

    const currentAge = numOrNull('currentAge');
    const result = calculateFire({
      desiredMonthlyIncome: num('desiredMonthlyIncome'),
      currentAmount: num('currentAmount'),
      monthlyContribution: num('monthlyContribution'),
      nominalReturnPercent: num('nominalReturnPercent'),
      inflationPercent: num('inflationPercent'),
      withdrawalRatePercent: num('withdrawalRatePercent'),
      currentAge,
    });

    document.getElementById('result-headline')!.textContent =
      `You need ${euro.format(result.fireNumber)} invested to live on ${euro.format(num('desiredMonthlyIncome'))} per month.`;

    const primaryAge = result.primary.ageAtFire !== null ? ` (age ${result.primary.ageAtFire.toFixed(1)})` : '';
    document.getElementById('result-primary-pace')!.textContent =
      `At current pace: ${formatYears(result.primary.yearsToFire)}${primaryAge}.`;

    const lowerReturnLabel = `${result.lowerReturn.nominalReturnPercent.toFixed(1)}%`;
    document.getElementById('legend-lower-return')!.textContent = `At ${lowerReturnLabel} nominal`;
    document.getElementById('result-lower-pace')!.textContent =
      `At ${lowerReturnLabel}: ${formatYears(result.lowerReturn.yearsToFire)}.`;

    const coastEl = document.getElementById('result-coast')!;
    if (result.primary.coastFireAchieved) {
      coastEl.textContent = "You've already reached Coast FIRE: even without investing anything else, growth alone should get you there.";
    } else if (result.primary.coastFireNumber !== null) {
      coastEl.textContent = `If you stopped investing today, you'd need ${euro.format(result.primary.coastFireNumber)} to get there on growth alone.`;
    } else {
      coastEl.textContent = '';
    }

    // Chart: project both scenarios out to whichever horizon is longer (capped, since "never"
    // scenarios have no natural endpoint), always at least a few years so the chart never
    // collapses to a single point.
    const primaryYears = result.primary.yearsToFire ?? 40;
    const lowerYears = result.lowerReturn.yearsToFire ?? 40;
    const horizonYears = Math.max(5, Math.min(60, Math.ceil(Math.max(primaryYears, lowerYears))));

    const monthlyContribution = num('monthlyContribution');
    const currentAmount = num('currentAmount');
    const primaryMonthlyRate = result.primary.realReturnPercent / 100 / 12;
    const lowerMonthlyRate = result.lowerReturn.realReturnPercent / 100 / 12;

    const primarySeries = projectPortfolioByYear({
      currentAmount,
      monthlyContribution,
      monthlyRate: primaryMonthlyRate,
      years: horizonYears,
    });
    const lowerSeries = projectPortfolioByYear({
      currentAmount,
      monthlyContribution,
      monthlyRate: lowerMonthlyRate,
      years: horizonYears,
    });

    renderChart(primarySeries, lowerSeries, result.fireNumber, horizonYears);

    if (!hasTrackedCompletion) {
      hasTrackedCompletion = true;
      track('tool_completed');
    }
  }

  // --- Chart rendering ---
  const PADDING_LEFT = 56;
  const PADDING_RIGHT = 16;
  const PADDING_TOP = 16;
  const PADDING_BOTTOM = 28;
  const CHART_WIDTH = 640;
  const CHART_HEIGHT = 300;
  const PLOT_WIDTH = CHART_WIDTH - PADDING_LEFT - PADDING_RIGHT;
  const PLOT_HEIGHT = CHART_HEIGHT - PADDING_TOP - PADDING_BOTTOM;

  let currentPrimarySeries: number[] = [];
  let currentLowerSeries: number[] = [];
  let currentMaxValue = 1;
  let currentHorizonYears = 1;

  function formatEuroShort(value: number): string {
    if (value >= 1_000_000) return `€${(value / 1_000_000).toFixed(1)}M`;
    if (value >= 1_000) return `€${Math.round(value / 1000)}k`;
    return euro.format(value);
  }

  function xForYear(year: number): number {
    return PADDING_LEFT + (year / currentHorizonYears) * PLOT_WIDTH;
  }
  function yForValue(value: number): number {
    return PADDING_TOP + PLOT_HEIGHT - (value / currentMaxValue) * PLOT_HEIGHT;
  }

  function renderChart(primarySeries: number[], lowerSeries: number[], fireNumber: number, horizonYears: number) {
    currentPrimarySeries = primarySeries;
    currentLowerSeries = lowerSeries;
    currentHorizonYears = horizonYears;
    currentMaxValue = Math.max(fireNumber, ...primarySeries, ...lowerSeries) * 1.08;

    const primaryPoints = primarySeries.map((value, year) => `${xForYear(year)},${yForValue(value)}`).join(' ');
    const lowerPoints = lowerSeries.map((value, year) => `${xForYear(year)},${yForValue(value)}`).join(' ');

    document.getElementById('chart-line-primary')!.setAttribute('points', primaryPoints);
    document.getElementById('chart-line-lower')!.setAttribute('points', lowerPoints);

    const fireLine = document.getElementById('chart-fire-line')!;
    const fireY = yForValue(fireNumber);
    fireLine.setAttribute('x1', String(PADDING_LEFT));
    fireLine.setAttribute('x2', String(CHART_WIDTH - PADDING_RIGHT));
    fireLine.setAttribute('y1', String(fireY));
    fireLine.setAttribute('y2', String(fireY));

    // Gridlines + y-axis labels at 4 evenly spaced values, muted per the dataviz skill's own
    // "recessive grid/axes" rule.
    const gridGroup = document.getElementById('chart-gridlines')!;
    gridGroup.innerHTML = '';
    const steps = 4;
    for (let i = 0; i <= steps; i++) {
      const value = (currentMaxValue / steps) * i;
      const y = yForValue(value);
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(PADDING_LEFT));
      line.setAttribute('x2', String(CHART_WIDTH - PADDING_RIGHT));
      line.setAttribute('y1', String(y));
      line.setAttribute('y2', String(y));
      line.setAttribute('stroke', 'var(--color-line)');
      line.setAttribute('stroke-width', '1');
      gridGroup.appendChild(line);

      const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      label.setAttribute('x', String(PADDING_LEFT - 8));
      label.setAttribute('y', String(y + 4));
      label.setAttribute('text-anchor', 'end');
      label.setAttribute('font-size', '10');
      label.setAttribute('fill', 'var(--color-ink-faint)');
      label.textContent = formatEuroShort(value);
      gridGroup.appendChild(label);
    }
    // x-axis year labels (start, middle, end).
    [0, Math.round(horizonYears / 2), horizonYears].forEach((year) => {
      const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      label.setAttribute('x', String(xForYear(year)));
      label.setAttribute('y', String(CHART_HEIGHT - 8));
      label.setAttribute('text-anchor', year === 0 ? 'start' : year === horizonYears ? 'end' : 'middle');
      label.setAttribute('font-size', '10');
      label.setAttribute('fill', 'var(--color-ink-faint)');
      label.textContent = `${year}y`;
      gridGroup.appendChild(label);
    });
  }

  // --- Hover crosshair + tooltip ---
  const hoverArea = document.getElementById('chart-hover-area') as unknown as SVGRectElement;
  const chartSvg = document.getElementById('fire-chart') as unknown as SVGSVGElement;
  const crosshair = document.getElementById('chart-crosshair')!;
  const tooltip = document.getElementById('chart-tooltip')!;
  const tooltipYear = document.getElementById('tooltip-year')!;
  const tooltipPrimary = document.getElementById('tooltip-primary')!;
  const tooltipLower = document.getElementById('tooltip-lower')!;

  function pointerToChartX(clientX: number): number {
    const rect = chartSvg.getBoundingClientRect();
    const scaleX = CHART_WIDTH / rect.width;
    return (clientX - rect.left) * scaleX;
  }

  hoverArea.addEventListener('mousemove', (event) => {
    const x = pointerToChartX(event.clientX);
    const year = Math.round(((x - PADDING_LEFT) / PLOT_WIDTH) * currentHorizonYears);
    const clampedYear = Math.max(0, Math.min(currentHorizonYears, year));
    if (!currentPrimarySeries[clampedYear] && clampedYear !== 0) return;

    const lineX = xForYear(clampedYear);
    crosshair.setAttribute('x1', String(lineX));
    crosshair.setAttribute('x2', String(lineX));
    crosshair.setAttribute('y1', String(PADDING_TOP));
    crosshair.setAttribute('y2', String(PADDING_TOP + PLOT_HEIGHT));
    crosshair.setAttribute('opacity', '1');

    const tooltipX = Math.min(lineX + 10, CHART_WIDTH - 158);
    tooltip.setAttribute('transform', `translate(${tooltipX}, ${PADDING_TOP + 4})`);
    tooltip.setAttribute('opacity', '1');
    tooltipYear.textContent = `Year ${clampedYear}`;
    tooltipPrimary.textContent = `Current pace: ${formatEuroShort(currentPrimarySeries[clampedYear] ?? 0)}`;
    tooltipLower.textContent = `Lower return: ${formatEuroShort(currentLowerSeries[clampedYear] ?? 0)}`;
  });

  hoverArea.addEventListener('mouseleave', () => {
    crosshair.setAttribute('opacity', '0');
    tooltip.setAttribute('opacity', '0');
  });

  form.addEventListener('input', (event) => {
    if ((event.target as HTMLElement)?.id === 'monthlyContributionSlider') {
      recalc();
      return;
    }
    if ((event.target as HTMLElement)?.id === 'monthlyContribution') {
      contributionSlider.value = contributionInput.value;
    }
    recalc();
  });

  document.getElementById('bridge-cta')?.addEventListener('click', () => track('tool_bridge_click'));

  if (!hasTrackedView) {
    hasTrackedView = true;
    track('tool_view');
  }
  recalc();
</script>
