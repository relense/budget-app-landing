# See src/lib/constants.ts for the full contract this URL is expected to satisfy.
# Local dev: point at a local budget-app-api server, e.g. http://localhost:4400/waitlist
# Production: https://budget-app-api-6hrz.onrender.com/waitlist (once develop -> main is deployed)
WAITLIST_API_URL=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX), from the GA4 property's Data Streams
# settings. Left empty, CookieConsent.astro renders nothing and no tracking script loads at all --
# there is no placeholder/fake ID here, since one would silently send data nowhere real. Only
# loaded client-side after the visitor accepts the cookie-consent banner (or immediately, if they
# already accepted on a previous visit); "Reject" never loads it, no exceptions.
PUBLIC_GA_MEASUREMENT_ID=
